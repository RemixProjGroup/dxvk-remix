/* rtx.ptPerformance.firstHit: the primary-ray RayQuery G-buffer kernels (gbuffer_rayquery.comp.slang) that take the first
   interaction of each camera ray from the raster first hit's visibility buffer (GBUFFER_VISIBILITY_INPUT, see
   geometryResolverRasterFirstHit in geometry_resolver.slangh). Only the feature sets performance mode runs have them: PSR Prepare
   with WBOIT and without NRC, with and without stochastic alpha, at Full and every slim level (same defines as
   gbuffer_rayquery_slim.comp.slang), and the debug feature set for the debug views. The PSR passes keep their kernels. */

//!variant gbuffer_rayquery_psr_prepare_wboit_visibility.comp
//!>       RAY_TRACING_PRIMARY_RAY ATMOSPHERE_AVAILABLE
//!>       GBUFFER_FEATURE_DLSSRR=1 GBUFFER_FEATURE_OBJECT_PICKING=0 GBUFFER_FEATURE_RAYTRACED_RENDER_TARGET=0 GBUFFER_FEATURE_STOCHASTIC_ALPHA=0
//!>       GBUFFER_FEATURE_PSR_REPLACEMENT=1 GBUFFER_FEATURE_INLINE_PSR_SAMPLING=0
//!>       UNORDERED_RESOLVE_WBOIT GBUFFER_VISIBILITY_INPUT

//!variant gbuffer_rayquery_psr_prepare_wboit_slim_visibility.comp
//!>       RAY_TRACING_PRIMARY_RAY ATMOSPHERE_AVAILABLE
//!>       GBUFFER_FEATURE_DLSSRR=1 GBUFFER_FEATURE_OBJECT_PICKING=0 GBUFFER_FEATURE_RAYTRACED_RENDER_TARGET=0 GBUFFER_FEATURE_STOCHASTIC_ALPHA=0
//!>       GBUFFER_FEATURE_PSR_REPLACEMENT=1 GBUFFER_FEATURE_INLINE_PSR_SAMPLING=0
//!>       UNORDERED_RESOLVE_WBOIT GBUFFER_VISIBILITY_INPUT
//!>       GBUFFER_SLIM_NO_POM GBUFFER_SLIM_NO_THIN_FILM GBUFFER_SLIM_NO_PORTALS

//!variant gbuffer_rayquery_psr_prepare_wboit_lean_visibility.comp
//!>       RAY_TRACING_PRIMARY_RAY ATMOSPHERE_AVAILABLE
//!>       GBUFFER_FEATURE_DLSSRR=1 GBUFFER_FEATURE_OBJECT_PICKING=0 GBUFFER_FEATURE_RAYTRACED_RENDER_TARGET=0 GBUFFER_FEATURE_STOCHASTIC_ALPHA=0
//!>       GBUFFER_FEATURE_PSR_REPLACEMENT=1 GBUFFER_FEATURE_INLINE_PSR_SAMPLING=0
//!>       UNORDERED_RESOLVE_WBOIT GBUFFER_VISIBILITY_INPUT
//!>       GBUFFER_SLIM_NO_POM GBUFFER_SLIM_NO_THIN_FILM GBUFFER_SLIM_NO_PORTALS GBUFFER_SLIM_NO_SSS

//!variant gbuffer_rayquery_psr_prepare_wboit_slimpom_visibility.comp
//!>       RAY_TRACING_PRIMARY_RAY ATMOSPHERE_AVAILABLE
//!>       GBUFFER_FEATURE_DLSSRR=1 GBUFFER_FEATURE_OBJECT_PICKING=0 GBUFFER_FEATURE_RAYTRACED_RENDER_TARGET=0 GBUFFER_FEATURE_STOCHASTIC_ALPHA=0
//!>       GBUFFER_FEATURE_PSR_REPLACEMENT=1 GBUFFER_FEATURE_INLINE_PSR_SAMPLING=0
//!>       UNORDERED_RESOLVE_WBOIT GBUFFER_VISIBILITY_INPUT
//!>       GBUFFER_SLIM_NO_THIN_FILM GBUFFER_SLIM_NO_PORTALS

//!variant gbuffer_rayquery_psr_prepare_wboit_leanpom_visibility.comp
//!>       RAY_TRACING_PRIMARY_RAY ATMOSPHERE_AVAILABLE
//!>       GBUFFER_FEATURE_DLSSRR=1 GBUFFER_FEATURE_OBJECT_PICKING=0 GBUFFER_FEATURE_RAYTRACED_RENDER_TARGET=0 GBUFFER_FEATURE_STOCHASTIC_ALPHA=0
//!>       GBUFFER_FEATURE_PSR_REPLACEMENT=1 GBUFFER_FEATURE_INLINE_PSR_SAMPLING=0
//!>       UNORDERED_RESOLVE_WBOIT GBUFFER_VISIBILITY_INPUT
//!>       GBUFFER_SLIM_NO_THIN_FILM GBUFFER_SLIM_NO_PORTALS GBUFFER_SLIM_NO_SSS

//!variant gbuffer_rayquery_psr_prepare_stochastic_alpha_wboit_visibility.comp
//!>       RAY_TRACING_PRIMARY_RAY ATMOSPHERE_AVAILABLE
//!>       GBUFFER_FEATURE_DLSSRR=1 GBUFFER_FEATURE_OBJECT_PICKING=0 GBUFFER_FEATURE_RAYTRACED_RENDER_TARGET=0 GBUFFER_FEATURE_STOCHASTIC_ALPHA=1
//!>       GBUFFER_FEATURE_PSR_REPLACEMENT=1 GBUFFER_FEATURE_INLINE_PSR_SAMPLING=0
//!>       UNORDERED_RESOLVE_WBOIT GBUFFER_VISIBILITY_INPUT

//!variant gbuffer_rayquery_psr_prepare_stochastic_alpha_wboit_slim_visibility.comp
//!>       RAY_TRACING_PRIMARY_RAY ATMOSPHERE_AVAILABLE
//!>       GBUFFER_FEATURE_DLSSRR=1 GBUFFER_FEATURE_OBJECT_PICKING=0 GBUFFER_FEATURE_RAYTRACED_RENDER_TARGET=0 GBUFFER_FEATURE_STOCHASTIC_ALPHA=1
//!>       GBUFFER_FEATURE_PSR_REPLACEMENT=1 GBUFFER_FEATURE_INLINE_PSR_SAMPLING=0
//!>       UNORDERED_RESOLVE_WBOIT GBUFFER_VISIBILITY_INPUT
//!>       GBUFFER_SLIM_NO_POM GBUFFER_SLIM_NO_THIN_FILM GBUFFER_SLIM_NO_PORTALS

//!variant gbuffer_rayquery_psr_prepare_stochastic_alpha_wboit_lean_visibility.comp
//!>       RAY_TRACING_PRIMARY_RAY ATMOSPHERE_AVAILABLE
//!>       GBUFFER_FEATURE_DLSSRR=1 GBUFFER_FEATURE_OBJECT_PICKING=0 GBUFFER_FEATURE_RAYTRACED_RENDER_TARGET=0 GBUFFER_FEATURE_STOCHASTIC_ALPHA=1
//!>       GBUFFER_FEATURE_PSR_REPLACEMENT=1 GBUFFER_FEATURE_INLINE_PSR_SAMPLING=0
//!>       UNORDERED_RESOLVE_WBOIT GBUFFER_VISIBILITY_INPUT
//!>       GBUFFER_SLIM_NO_POM GBUFFER_SLIM_NO_THIN_FILM GBUFFER_SLIM_NO_PORTALS GBUFFER_SLIM_NO_SSS

//!variant gbuffer_rayquery_psr_prepare_stochastic_alpha_wboit_slimpom_visibility.comp
//!>       RAY_TRACING_PRIMARY_RAY ATMOSPHERE_AVAILABLE
//!>       GBUFFER_FEATURE_DLSSRR=1 GBUFFER_FEATURE_OBJECT_PICKING=0 GBUFFER_FEATURE_RAYTRACED_RENDER_TARGET=0 GBUFFER_FEATURE_STOCHASTIC_ALPHA=1
//!>       GBUFFER_FEATURE_PSR_REPLACEMENT=1 GBUFFER_FEATURE_INLINE_PSR_SAMPLING=0
//!>       UNORDERED_RESOLVE_WBOIT GBUFFER_VISIBILITY_INPUT
//!>       GBUFFER_SLIM_NO_THIN_FILM GBUFFER_SLIM_NO_PORTALS

//!variant gbuffer_rayquery_psr_prepare_stochastic_alpha_wboit_leanpom_visibility.comp
//!>       RAY_TRACING_PRIMARY_RAY ATMOSPHERE_AVAILABLE
//!>       GBUFFER_FEATURE_DLSSRR=1 GBUFFER_FEATURE_OBJECT_PICKING=0 GBUFFER_FEATURE_RAYTRACED_RENDER_TARGET=0 GBUFFER_FEATURE_STOCHASTIC_ALPHA=1
//!>       GBUFFER_FEATURE_PSR_REPLACEMENT=1 GBUFFER_FEATURE_INLINE_PSR_SAMPLING=0
//!>       UNORDERED_RESOLVE_WBOIT GBUFFER_VISIBILITY_INPUT
//!>       GBUFFER_SLIM_NO_THIN_FILM GBUFFER_SLIM_NO_PORTALS GBUFFER_SLIM_NO_SSS

//!variant gbuffer_rayquery_debug_wboit_visibility.comp
//!>       RAY_TRACING_PRIMARY_RAY ATMOSPHERE_AVAILABLE
//!>       GBUFFER_FEATURE_DEBUG_VIEW=1 GBUFFER_FEATURE_OBJECT_PICKING=1
//!>       UNORDERED_RESOLVE_WBOIT GBUFFER_VISIBILITY_INPUT

//!end-variants

#include "rtx/pass/gbuffer/gbuffer_rayquery.comp.slang"
