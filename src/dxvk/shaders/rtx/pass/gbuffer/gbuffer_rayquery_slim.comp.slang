//!>       UNORDERED_RESOLVE_WBOIT
//!>       GBUFFER_SLIM_NO_POM GBUFFER_SLIM_NO_THIN_FILM GBUFFER_SLIM_NO_PORTALS GBUFFER_SLIM_NO_SSS

