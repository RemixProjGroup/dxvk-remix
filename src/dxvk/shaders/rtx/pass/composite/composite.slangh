#include "rtx/utility/nrd.slangh"
#include "rtx/utility/color.slangh"

// The fog modes of cb.fogMode. The values are frontend::FogMode's.
static const uint kFogModeNone = 0;
static const uint kFogModeExp = 1;
static const uint kFogModeExp2 = 2;
static const uint kFogModeLinear = 3;

vec4 calculateFog(float viewDistance)
{
  if (cb.fogMode == kFogModeNone)
  {
    return vec4(0.0);
  }

  // NV-DXVK start: Retain accumulated fog beyond its integration distance.
  // Discarding it here leaves an unfogged band on distant geometry and the sky.
  viewDistance = clamp(viewDistance, 0.0f, max(cb.maxFogDistance, 0.0f));
  // NV-DXVK end

  // https://docs.microsoft.com/en-us/windows/win32/direct3d9/fog-formulas

  float f = 0;

  if (cb.fogMode == kFogModeLinear)
  {
    f = (cb.fogEnd - viewDistance) * cb.fogScale;
  }
  else if (cb.fogMode == kFogModeExp)
  {
    float d = viewDistance * cb.fogDensity;
    f = exp(-d);
  }
  else if (cb.fogMode == kFogModeExp2)
  {
    float d = viewDistance * cb.fogDensity;
    f = exp(-d * d);
  }

  f = clamp(f, 0.0, 1.0);

  return vec4(cb.fogColor, 1.0 - f);
}

void unpackDenoiserRadiance(inout float3 radiance, uint denoiserMode)
{
  switch (denoiserMode)
  {
    case DENOISER_MODE_RELAX:
      radiance = RELAX_BackEnd_UnpackRadiance(float4(radiance, 0)).xyz * cb.denoiserToFrame;
      break;
    case DENOISER_MODE_REBLUR:
      radiance = REBLUR_BackEnd_UnpackRadianceAndNormHitDist(float4(radiance, 0)).xyz * cb.denoiserToFrame;
      break;
  }
}

vec3 applyPostFilter(Texture2D<float4> texture, uint2 pixel, uint denoiserMode)
{
  vec3 centerColor = texture[pixel].xyz;
  unpackDenoiserRadiance(centerColor, denoiserMode);
  vec3 totalColor = vec3(0);
  uint count = 0;
  for (int i = -1; i <= 1; ++i)
  {
    for (int j = -1; j <= 1; ++j)
    {
      if (i != 0 && j != 0)
      {
        vec3 color = texture[pixel + int2(i, j)].xyz;
        unpackDenoiserRadiance(color, denoiserMode);
        count += any(color > vec3(0)) ? 1 : 0;
        totalColor += color;
      }
    }
  }

  vec3 avgColor = totalColor / max(1, count);
  if (calcBt709Luminance(centerColor) > calcBt709Luminance(avgColor) * cb.postFilterThreshold)
  {
    centerColor = avgColor;
  }
  return centerColor;
}

// Clamp to the nearest valid texel so edge pixels do not get biased darker by missing neighbors.
int2 clampPixelCoordinate(int2 pixelCoordinate, int2 offset)
{
  return clamp(pixelCoordinate + offset, 0, cb.camera.resolution - 1);
}
