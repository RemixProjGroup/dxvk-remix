#pragma once

#include "rtx/pass/sharc/sharc_update_tile.slangh"
#include "rtx/algorithm/pt_performance_counters.slangh"

// SHARC's contract with the indirect integrator. The bodies live here so that
// integrator_indirect.slangh carries call sites rather than preprocessor blocks.

#if ENABLE_SHARC
// Why a resolved vertex is refused, in evaluation order. The first failing term is the one reported,
// so the debug view and the eligibility test derive from one function and cannot disagree.
// The codes index sharcDebugPalette, so their values set the debug view colours.
static const uint kSharcRejectNone = 0;
static const uint kSharcRejectEmissive = 5;    // emissive radiance above maxEmissiveLuminance
static const uint kSharcRejectLobe = 6;        // non-diffuse arrival while specular reuse is off

// The update inserts and the query looks up through this one predicate.
// It has no material terms, so a non-opaque vertex is eligible like an opaque one.
uint sharcRejectReason(vec3 emissiveLight, bool lobeEligible)
{
  if (calcBt709Luminance(emissiveLight) > cb.sharcArgs.maxEmissiveLuminance)
  {
    return kSharcRejectEmissive;
  }
  if (!lobeEligible)
  {
    return kSharcRejectLobe;
  }
  return kSharcRejectNone;
}
#endif

#if ENABLE_SHARC && SHARC_QUERY
// The cone-footprint gate for glossy arrivals. By the time the lobe that launched the segment reaches
// this vertex it must have spread wider than the voxel, or a narrow reflection would be served the cell's
// isotropic average. The roughness is the perceptual roughness summed over the path so far.
// The length is the whole segment, because cutout, clip and portal re-traces continue the same lobe.
// A diffuse lobe is as wide as lobes get and is never tested.
bool sharcFootprintValid(float launchPerceptualRoughness, float segmentLength, float voxelSize)
{
  const float clampedRoughness = min(launchPerceptualRoughness, 0.99f);
  const float alpha = clampedRoughness * clampedRoughness;
  const float alpha2 = alpha * alpha;
  const float footprint = segmentLength * sqrt(0.5f * alpha2 / max(1.0f - alpha2, 1e-6f));
  return footprint > voxelSize;
}

// cb.debugView is uniform, so a production frame pays one range compare per resolved vertex.
// The SHARC indices are contiguous so that the one compare covers all of them.
bool sharcDebugViewActive()
{
  return cb.debugView >= DEBUG_VIEW_SHARC_QUERY_OUTCOME && cb.debugView <= DEBUG_VIEW_SHARC_CELL_AGE;
}

// Per-pixel views show one indirect vertex, selected by round(debugKnob.x) with 0 as the first
// indirect hit, matching the NRC bounce views.
bool sharcDebugBounceSelected(uint bounceIteration)
{
  return bounceIteration == uint(max(0, int(round(cb.debugKnob.x)))) + 1;
}

vec3 sharcDebugPalette(uint code)
{
  switch (code)
  {
  case 1: return vec3(1.0f, 0.0f, 0.0f); // red
  case 2: return vec3(0.0f, 1.0f, 0.0f); // green
  case 3: return vec3(0.0f, 0.0f, 1.0f); // blue
  case 4: return vec3(1.0f, 1.0f, 0.0f); // yellow
  case 5: return vec3(1.0f, 0.0f, 1.0f); // magenta
  case 6: return vec3(0.0f, 1.0f, 1.0f); // cyan
  case 8: return vec3(0.5f, 0.5f, 0.5f); // grey
  default: return vec3(0.0f, 0.0f, 0.0f);
  }
}

// Views that want every resolved vertex at the selected bounce, eligible or not.
void sharcDebugVertex(PathState pathState, SurfaceInteraction surfaceInteraction, uint sharcReason)
{
  const uvec2 pixel = pathState.pixelCoordinate;
  switch (cb.debugView)
  {
  case DEBUG_VIEW_SHARC_QUERY_OUTCOME:
    // Grey: rejected before any lookup. Eligible vertices are painted by sharcDebugQuery.
    if (sharcReason != kSharcRejectNone)
    {
      storeInDebugView(pixel, sharcDebugPalette(8));
    }
    break;
  case DEBUG_VIEW_SHARC_REJECT_REASON:
    // Black eligible, magenta emissive, cyan lobe.
    storeInDebugView(pixel, sharcDebugPalette(sharcReason));
    break;
  case DEBUG_VIEW_SHARC_GRID_CELLS:
  case DEBUG_VIEW_SHARC_CELL_AGE:
  {
    SharcParameters p = makeSharcParametersAt(pathState.portalSpace, surfaceInteraction.position);
    if (cb.debugView == DEBUG_VIEW_SHARC_GRID_CELLS)
    {
      storeInDebugView(pixel, HashGridDebugColoredHash(surfaceInteraction.position, surfaceInteraction.geometryNormal, p.hashGridParameters));
    }
    else
    {
      const HashGridKey key = HashGridComputeSpatialHash(surfaceInteraction.position, surfaceInteraction.geometryNormal, p.hashGridParameters);
      HashGridIndex index;
      uint bucketOffset;
      if (HashGridFind(p.hashGridData, key, HashGridGetBaseSlot(key, p.hashGridData.capacity), HASH_GRID_HASH_MAP_BUCKET_SIZE, index, bucketOffset))
      {
        const SharcVoxelData voxel = SharcGetVoxelData(p.resolvedBuffer, index);
        // R frames accumulated, G frames since the last sample, B sample count. Absent cells stay black.
        storeInDebugView(pixel, vec4(float(voxel.accumulatedFrameNum), float(voxel.staleFrameNum), voxel.accumulatedSampleNum, 1.0f));
      }
    }
    break;
  }
  default:
    break;
  }
}

// Views fed by the lookup itself.
void sharcDebugQuery(PathState pathState, bool selectedBounce, bool farEnough, bool footprintOk, bool cacheHit, vec3 cachedRadiance)
{
  const uvec2 pixel = pathState.pixelCoordinate;
  switch (cb.debugView)
  {
  case DEBUG_VIEW_SHARC_QUERY_OUTCOME:
    if (selectedBounce)
    {
      // Green hit, blue too close, yellow footprint too narrow, red miss.
      storeInDebugView(pixel, sharcDebugPalette(cacheHit ? 2u : !farEnough ? 3u : !footprintOk ? 4u : 1u));
    }
    break;
  case DEBUG_VIEW_SHARC_CACHED_RADIANCE:
    // A hit ends the path, so at most one write per pixel: the radiance actually used.
    if (cacheHit)
    {
      storeInDebugView(pixel, cachedRadiance);
    }
    break;
  case DEBUG_VIEW_SHARC_TERMINATION_BOUNCE:
    if (cacheHit)
    {
      storeInDebugView(pixel, float(pathState.bounceIteration));
    }
    break;
  default:
    break;
  }
}
#endif

#if ENABLE_SHARC && SHARC_QUERY
// Counts why the cache supplied no light at a first indirect hit that passed the reject test.
// The second lookup runs only for misses that reached the lookup, and only while performance mode counts.
void sharcCountFirstMiss(SharcParameters sharcParameters, HashGridKey key, bool firstMiss, bool farEnough, bool footprintOk)
{
  ptPerformanceCounterAdd(PT_PERFORMANCE_COUNTER_MISS_TOO_CLOSE, firstMiss && !farEnough);
  ptPerformanceCounterAdd(PT_PERFORMANCE_COUNTER_MISS_FOOTPRINT, firstMiss && farEnough && !footprintOk);

  bool noEntry = false;
  bool unfilled = false;
  if (firstMiss && farEnough && footprintOk)
  {
    HashGridIndex index;
    uint bucketOffset;
    if (HashGridFind(sharcParameters.hashGridData, key, HashGridGetBaseSlot(key, sharcParameters.hashGridData.capacity),
                     HASH_GRID_HASH_MAP_BUCKET_SIZE, index, bucketOffset))
    {
      unfilled = SharcGetVoxelData(sharcParameters.resolvedBuffer, index).accumulatedSampleNum <= SHARC_SAMPLE_NUM_THRESHOLD;
    }
    else
    {
      noEntry = true;
    }
  }
  ptPerformanceCounterAdd(PT_PERFORMANCE_COUNTER_MISS_NO_ENTRY, noEntry);
  ptPerformanceCounterAdd(PT_PERFORMANCE_COUNTER_MISS_UNFILLED, unfilled);
}
#endif

// Called when a segment leaves the scene, before the bounce count is reduced for the miss.
void sharcOnMiss(PathState pathState)
{
#if ENABLE_SHARC && SHARC_QUERY
  ptPerformanceCounterAdd(PT_PERFORMANCE_COUNTER_SKY, pathState.bounceIteration <= 1);
#endif
}

// Called once per path, after the launch state is loaded and before the first segment is traced.
// Seeds the path-summed roughness of the query's footprint gate with the primary's perceptual roughness,
// or with 0 when the first lobe passed through a cutout, as upstream does.
// sharcOnContinuationSampled adds to it for every later segment.
void sharcOnLaunch(inout PathState pathState, uvec2 pixel, float firstHitPerceptualRoughness)
{
#if ENABLE_SHARC && SHARC_QUERY
  IndirectSampleData indirectSampleData;
  indirectSampleData.load(u16vec2(pixel), FirstSampledLobeData);
  pathState.sharcLaunchPerceptualRoughness =
    indirectSampleData.firstSampledLobeIsOpacityTransmission ? 0.0f : firstHitPerceptualRoughness;
#endif
}

// Called once per secondary segment, before its first trace.
void sharcOnSegmentBegin(inout PathState pathState)
{
#if ENABLE_SHARC && SHARC_QUERY
  pathState.sharcSegmentDistance = 0.0f;
#endif
}

// Called after every resolve leg of a segment, whether resolving stops there or re-traces.
// Cutouts, clipped geometry, portal quads and teleports each restart segmentHitDistance from the
// interaction, so on its own that is the last leg rather than the distance from the previous vertex.
void sharcOnResolveLeg(inout PathState pathState)
{
#if ENABLE_SHARC && SHARC_QUERY
  // Misses carry kMissHitDistance.
  if (pathState.segmentHitDistance > 0.0f)
  {
    pathState.sharcSegmentDistance = pathState.sharcSegmentDistance + pathState.segmentHitDistance;
  }
#endif
}

// Called once the continuation lobe has been sampled at an opaque or translucent vertex, before
// the next segment is traced. The query at the next vertex gates on the lobe that launched the
// segment and cannot see this vertex, so what it needs is carried on the path state.
void sharcOnContinuationSampled(inout PathState pathState, bool opaqueMaterial, uint8_t continuationLobe, float isotropicRoughness)
{
#if ENABLE_SHARC
  // The next arrival is diffuse when an opaque surface continues with diffuse reflection or diffuse transmission.
  pathState.sharcDiffuseArrival = opaqueMaterial &&
    (continuationLobe == opaqueLobeTypeDiffuseReflection || continuationLobe == opaqueLobeTypeDiffuseTransmission);
#endif
#if ENABLE_SHARC && SHARC_QUERY
  // As in upstream's sharc_integrator_utilities.slangh onBounceEnd, the footprint test reads the perceptual roughness
  // summed over the path. A vertex adds 1 for diffuse reflection or a non-opaque surface, and 0 for a cutout pass-through.
  // Otherwise it adds its own roughness, which is sqrt(isotropicRoughness) because that is GGX alpha.
  // The gate clamps the sum to 0.99, so after any diffuse reflection every later arrival passes it.
  float vertexRoughness = 1.0f;
  if (opaqueMaterial)
  {
    vertexRoughness = continuationLobe == opaqueLobeTypeOpacityTransmission ? 0.0f
      : continuationLobe == opaqueLobeTypeDiffuseReflection ? 1.0f
      : sqrt(isotropicRoughness);
  }
  pathState.sharcLaunchPerceptualRoughness = pathState.sharcLaunchPerceptualRoughness + vertexRoughness;
#endif
}

#if ENABLE_SHARC && SHARC_UPDATE
// RNG stream for re-sampled first bounces. The per-bounce closest-hit offsets stop well below it.
static const uint kSharcSkyRetryRngOffset = 240;

// The primary vertex's eligibility through the predicate secondary hits use.
// Only the emission is needed, decoded from the G-buffer words the direct pass reads.
uint sharcPrimaryRejectReason(uvec2 pixel)
{
  const uint data0 = SharedMaterialData0[pixel];
  const uint data1 = SharedMaterialData1[pixel];
  const vec3 emissive = gammaToLinearFast(vec3(
    unorm8ToF32(uint8_t(data0 >> 16)), unorm8ToF32(uint8_t(data1 >> 0)), unorm8ToF32(uint8_t(data1 >> 8))))
    * uint16BitsToF32(uint16_t(data1 >> 16));

  // The camera ray is the arrival, so there is no lobe to classify.
  return sharcRejectReason(emissive, true);
}

// Called once per update path after its launch state is final and before the first segment is traced.
// Deposits the primary vertex when SHARC_FLAG_UPDATE_PRIMARY_VERTEX is set. Its diffuse outgoing radiance is
// the diffuse direct light from the direct pass plus, on a diffuse continuation, the segment weight times
// whatever the path gathers onward.
//
// Only the diffuse part is deposited, because a cell holds one value for every direction it is read from.
// The primary is lit toward the camera with a material that sharcClampUpdateRoughness never touched,
// so its specular lobe would put highlights and mirror images into the cell.
//
// A path that will not launch, or whose first lobe was specular or an opacity transmission, still deposits
// the diffuse direct light with a zero segment weight. A cell is a mean of its samples, and a diffuse
// continuation's throughput already carries the 1/p of the lobe choice and of first-bounce roulette.
// Only with the other paths counted as zero-indirect samples does the mean equal diffuse direct + T * L.
void sharcOnPathStart(inout PathState pathState, uvec2 pixel, GeometryFlags geometryFlags)
{
  if ((cb.sharcArgs.flags & SHARC_FLAG_UPDATE_PRIMARY_VERTEX) == 0)
  {
    return;
  }
  // A PSR pixel's throughput carries the mirror or glass in front of its surface, a translucent primary
  // integrates the surface behind it, and a view model moves with the camera.
  // None of them makes a cell a world-space reader wants.
  if (!geometryFlags.primarySelectedIntegrationSurface || geometryFlags.performedAnyPSR() || geometryFlags.isViewModel)
  {
    return;
  }

  if (sharcPrimaryRejectReason(pixel) != kSharcRejectNone)
  {
    return;
  }

  const MinimalSurfaceInteraction primary = minimalSurfaceInteractionReadFromGBuffer(pixel, PrimaryWorldPositionWorldTriangleNormal);
  // Only the diffuse lobe is deposited (see above). This texture excludes the primary's own emission,
  // as the cache requires.
  const vec3 directLight = PrimaryDirectDiffuseLobeRadianceHitDistance[pixel].xyz;
  if (!primary.isValid || !isValidValue(directLight))
  {
    return;
  }

  SharcHitData sharcHit = (SharcHitData)0;
  sharcHit.positionWorld = primary.position;
  sharcHit.normalWorld = primary.geometryNormal;
  // The weight of the segment leaving the primary is the launch throughput the direct pass stored,
  // which is BSDF times cosine over the lobe and direction pdfs, with any POM attenuation.
  // It is zero unless the first lobe was diffuse, and the deposit is kept either way (see above).
  IndirectSampleData indirectSampleData;
  indirectSampleData.load(u16vec2(pixel), FirstSampledLobeData);
  const bool diffuseContinuation =
    !geometryFlags.firstSampledLobeIsSpecular && !indirectSampleData.firstSampledLobeIsOpacityTransmission;
  const vec3 segmentWeight = (pathState.continuePath && diffuseContinuation) ? vec3(pathState.throughput) : vec3(0.0f);

  const uint countBefore = pathState.sharcState.count;
  sharcInsertVertex(pathState.sharcState, sharcHit, pathState.portalSpace, pixel);
  if (pathState.sharcState.count > countBefore)
  {
    sharcSeedVertex(pathState.sharcState, directLight, segmentWeight);
  }
}

// Called after every traced segment of an update path. A first bounce that exited to the sky inserted
// nothing beyond the primary, so that bounce is re-sampled from a cosine lobe about the primary normal.
// What a cell stores does not depend on how a ray reached it, so this changes which cells get samples,
// not what they hold. The primary's own sample is flushed first, so a retry cannot credit it twice.
void sharcOnSegmentEnd(inout PathState pathState, uvec2 pixel, GeometryFlags geometryFlags,
  vec3 rayOrigin, float rayConeRadius, uint mediumMaterialIndex, inout uint retriesLeft)
{
  // A miss at bounce 1 leaves bounceIteration at 0, because integratePathVertex decrements it on the miss,
  // and continuePath false. Every other outcome leaves bounceIteration at 1 or more.
  if (retriesLeft == 0 || pathState.continuePath || pathState.bounceIteration != 0)
  {
    return;
  }
  // The ray that missed may have teleported first, so its state no longer describes the primary.
  if (pathState.portalSpace != geometryFlags.portalSpace)
  {
    return;
  }

  const MinimalSurfaceInteraction primary = minimalSurfaceInteractionReadFromGBuffer(pixel, PrimaryWorldPositionWorldTriangleNormal);
  if (!primary.isValid)
  {
    return;
  }

  --retriesLeft;
  // This flush is inline in every variant, deferred flush included. At a bounce-1 miss the state holds
  // at most the primary vertex, and the slots must be free for the re-sampled path.
  sharcFlushVertices(pathState.sharcState, pixel);
  pathState.sharcState.count = 0;

  RNG rng = createRNG(pixel, cb.frameIdx, kSharcSkyRetryRngOffset + retriesLeft * 2u);
  const vec2 u = vec2(getNextSampleBlueNoise(rng), getNextSampleBlueNoise(rng));
  float solidAnglePdf;
  const vec3 local = calcCosineHemisphereDirectionSample(u, solidAnglePdf);
  vec3 tangent, bitangent;
  calcOrthonormalBasis(primary.geometryNormal, tangent, bitangent);

  // Relaunch from the direct pass's offset origin, because the miss may have re-traced through cutouts
  // or media and moved the payload's origin and medium.
  pathState.origin = rayOrigin;
  pathState.direction = normalize(tangent * local.x + bitangent * local.y + primary.geometryNormal * local.z);
  pathState.coneRadius = rayConeRadius;
  pathState.mediumMaterialIndex = mediumMaterialIndex;
  pathState.insideMedium = geometryFlags.insideMedium;
  pathState.solidAnglePdf = solidAnglePdf;
  // A cosine lobe is a diffuse gather.
  pathState.sharcDiffuseArrival = true;
  pathState.continuePath = true;
}
#endif

// The update-stage roughness clamp, called once per resolved vertex after the eligibility test.
// A cell stores one non-directional radiance value, so it cannot represent a narrow specular lobe,
// and update paths reaching a glossy surface from different directions would never settle its mean.
// Roughening the material makes the deposit something a single value can hold.
// The clamp changes what a cell holds, not which surfaces have one.
void sharcClampUpdateRoughness(inout PolymorphicSurfaceMaterialInteraction polymorphicSurfaceMaterialInteraction, uint materialType)
{
#if ENABLE_SHARC && SHARC_UPDATE
  const float roughnessFloor = cb.sharcArgs.updateRoughnessClamp;
  if (roughnessFloor <= 0.0f || materialType != surfaceMaterialTypeOpaque)
  {
    return;
  }

  OpaqueSurfaceMaterialInteraction material = opaqueSurfaceMaterialInteractionCreate(polymorphicSurfaceMaterialInteraction);
  // An anisotropic axis can sit below the floor while the isotropic value clears it, so all three are tested.
  if (material.isotropicRoughness >= roughnessFloor && all(material.anisotropicRoughness >= vec2(roughnessFloor)))
  {
    return;
  }

  // Raising every axis to the same floor also flattens anisotropy, which the cache cannot represent either.
  material.isotropicRoughness = max(material.isotropicRoughness, roughnessFloor);
  material.anisotropicRoughness = max(material.anisotropicRoughness, vec2(roughnessFloor));
  polymorphicSurfaceMaterialInteraction = polymorphicSurfaceMaterialInteractionCreateInternal(material);
#endif
}

#if ENABLE_SHARC && SHARC_UPDATE
// RNG stream for the cache-resampling draw, above the sky retry streams (kSharcSkyRetryRngOffset + 2 * retries).
static const uint kSharcResampleRngOffset = 256;

// The SDK's cache resampling (SharcCommon.h SharcUpdateHit, SHARC_ENABLE_CACHE_RESAMPLING) at its default
// propagation depth of 2. At an eligible update vertex the path draws a depth round(lerp(1, 2, u)), and pathLength is
// the stored vertex count capped at 2. If the depth is at or below pathLength and the vertex's cell holds data,
// the cell's resolved radiance stands in for everything the path would gather from here on.
// It is accumulated through the segment weight like gathered light, the vertex is not stored, and the path ends.
// Cells then carry light from unlimited bounces instead of at most rtx.sharc.updateBounces.
// This also works with the deferred flush and in the TraceRay update hit shader.
bool sharcTryResample(inout PathState pathState, SharcParameters sharcParameters, SharcHitData sharcHit)
{
  const uint pathLength = min(pathState.sharcState.count, 2u);
  if (pathLength == 0)
  {
    return false;
  }
  RNG rng = createRNG(pathState.pixelCoordinate, cb.frameIdx, kSharcResampleRngOffset + uint(pathState.bounceIteration));
  const uint resamplingDepth = uint(round(lerp(1.0f, 2.0f, getNextSampleBlueNoise(rng))));
  if (resamplingDepth > pathLength)
  {
    return false;
  }
  vec3 cachedRadiance = vec3(0.0f);
  if (!SharcGetCachedRadiance(sharcParameters, sharcHit, cachedRadiance, false) || !isValidValue(cachedRadiance))
  {
    return false;
  }
  accumulateRadiance(pathState, sharcCacheToFrame(cachedRadiance));
  pathState.continuePath = false;
  return true;
}
#endif

// Called once per resolved vertex after emissive radiance has been accumulated,
// because the cache stores reflected lighting.
//
// Returns true when the cache supplied radiance for this vertex and the caller should stop walking
// the path.
bool sharcOnResolvedVertex(
  inout PathState pathState,
  SurfaceInteraction surfaceInteraction,
  vec3 emissiveLight)
{
#if ENABLE_SHARC
  const bool allowSpecularPaths = (cb.sharcArgs.flags & SHARC_FLAG_ALLOW_SPECULAR_PATHS) != 0;
  const uint sharcReason = sharcRejectReason(emissiveLight, pathState.sharcDiffuseArrival || allowSpecularPaths);
  const bool sharcEligible = sharcReason == kSharcRejectNone;

#if SHARC_QUERY
  const bool sharcFirstHit = pathState.bounceIteration <= 1;
  ptPerformanceCounterAdd(PT_PERFORMANCE_COUNTER_CACHE_QUERIES, sharcFirstHit);
  ptPerformanceCounterAdd(PT_PERFORMANCE_COUNTER_EXTRA_QUERIES, !sharcFirstHit);
  ptPerformanceCounterAdd(PT_PERFORMANCE_COUNTER_MISS_REJECTED, sharcFirstHit && !sharcEligible);

  const bool sharcDebugBounce = sharcDebugBounceSelected(pathState.bounceIteration);
  if (sharcDebugViewActive() && sharcDebugBounce)
  {
    sharcDebugVertex(pathState, surfaceInteraction, sharcReason);
  }
#endif

  // Portal space is part of the cache key, so a vertex reached through a portal occupies its own
  // cell rather than polluting the one main-space paths read back. That is what makes insertion
  // from portal space safe and lets portal-only geometry be cached at all.
  if (sharcEligible)
  {
    SharcParameters sharcParameters = makeSharcParametersAt(pathState.portalSpace, surfaceInteraction.position);
    SharcHitData sharcHit = (SharcHitData)0;
    sharcHit.positionWorld = surfaceInteraction.position;
    sharcHit.normalWorld = surfaceInteraction.geometryNormal;

#if SHARC_UPDATE
    if (sharcTryResample(pathState, sharcParameters, sharcHit))
    {
      return true;
    }
    sharcInsertVertex(pathState.sharcState, sharcHit, pathState.portalSpace, uvec2(pathState.pixelCoordinate));
#elif SHARC_QUERY
    float voxelSize;
    const HashGridKey key = HashGridComputeSpatialHashWithVoxelSize(sharcHit.positionWorld, sharcHit.normalWorld, sharcParameters.hashGridParameters, voxelSize);
    vec3 cachedRadiance = vec3(0.0f);
    // The voxel diagonal: a vertex closer than this to the previous one may share its cell.
    const float sharcTooCloseDistance = 1.732051f * voxelSize;
    const bool farEnough = pathState.segmentHitDistance > sharcTooCloseDistance;
    // The footprint gate only ever refuses a specular arrival and does not replace the distance
    // guard above. Above roughly 0.7 perceptual launching roughness the lobe has spread past the
    // voxel before the segment clears the voxel diagonal, so both tests are kept.
    const bool footprintOk = pathState.sharcDiffuseArrival
      || sharcFootprintValid(pathState.sharcLaunchPerceptualRoughness, pathState.sharcSegmentDistance, voxelSize);
    const bool cacheHit = farEnough && footprintOk
      && SharcGetCachedRadianceFromHash(sharcParameters, sharcHit, key, cachedRadiance, false)
      && isValidValue(cachedRadiance);
    cachedRadiance = sharcCacheToFrame(cachedRadiance);

    if (sharcDebugViewActive())
    {
      sharcDebugQuery(pathState, sharcDebugBounce, farEnough, footprintOk, cacheHit, cachedRadiance);
    }

    ptPerformanceCounterAdd(PT_PERFORMANCE_COUNTER_CACHE_HITS, cacheHit && sharcFirstHit);
    ptPerformanceCounterAdd(PT_PERFORMANCE_COUNTER_EXTRA_HITS, cacheHit && !sharcFirstHit);
    if (cb.ptPerformanceCounters)
    {
      sharcCountFirstMiss(sharcParameters, key, sharcFirstHit && !cacheHit, farEnough, footprintOk);
    }

    if (cacheHit)
    {
      accumulateRadiance(pathState, cachedRadiance);
      pathState.continuePath = false;
      return true;
    }
#endif
  }
#endif
  return false;
}
