#pragma once

#include "rtx/concept/camera/camera.slangh"
#include "rtx/pass/atmosphere/atmosphere_common.slangh"

// NV-DXVK start: Use the same active projection as the sky, clouds, and composite.
vec3 aerialPerspectiveViewRayDirection(vec2 screenUv, Camera camera)
{
  const CameraDirections ray = cameraScreenUVToDirection(camera, screenUv, false);
  // Slices measure positive view depth for both left- and right-handed projections.
  return ray.worldDirection / max(abs(ray.viewDirection.z), 1e-6f);
}

vec3 aerialPerspectiveScreenUvToUvw(
  vec2 screenUv, float viewRayDistance, Camera camera, AtmosphereArgs args)
{
  const CameraDirections ray = cameraScreenUVToDirection(camera, screenUv, false);
  const float forwardDistance = viewRayDistance * max(abs(ray.viewDirection.z), 1e-6f);
  return vec3(screenUv, aerialPerspectiveForwardDistanceToSlice(forwardDistance, args));
}
// NV-DXVK end
