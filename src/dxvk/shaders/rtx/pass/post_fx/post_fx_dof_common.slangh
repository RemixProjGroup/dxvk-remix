#pragma once

// Circle of confusion, bokeh kernel and dither helpers shared by the three
// depth-of-field passes.
//
// The functions below read the pass's `cb` push constant block, and the two
// guarded blocks read the pass's `PrimaryLinearViewZ` / `FocusState` bindings,
// so this header has to be included *after* those declarations (the same
// pattern rtx/utility/noise.slangh uses for BlueNoise). A pass opts into the
// guarded blocks by defining the matching macro before the include:
//
//   POST_FX_DOF_USE_LINEAR_VIEW_Z  - declares PrimaryLinearViewZ
//   POST_FX_DOF_USE_FOCUS_STATE    - declares FocusState

#include "rtx/pass/post_fx/post_fx.h"

static const float kDofGoldenAngle = 2.3999632f;
static const float kDofTwoPi = 6.2831853f;

// Number of taps a gather of the given radius asks for, before the
// rtx.dof.sampleCount ceiling is applied.
//
// A tap is a bilinear fetch of the half resolution colour buffer, so it
// integrates roughly a 2x2 half-res texel footprint, i.e. ~4 px^2. Covering a
// disc of area pi*r^2 without leaving holes therefore wants about
// pi*r^2 / 4 ~= 0.8*r^2 taps. Anything much sparser turns an isolated
// highlight into a speckle of bright dots instead of a bokeh disc, which is
// what a low tap count on a large radius looks like.
uint dofTapCountForRadius(const float radiusHalfPixels, const uint maxTaps)
{
  const uint requested = uint(ceil(0.8f * radiusHalfPixels * radiusHalfPixels));
  return clamp(requested, uint(POST_FX_DOF_MIN_SAMPLES), max(maxTaps, 1u));
}

// Interleaved gradient noise, from Jimenez, "Next Generation Post Processing
// in Call of Duty: Advanced Warfare". Unlike a sin/frac white-noise hash it is
// smooth over a few pixels, so neighbouring kernels are rotated by similar
// amounts and their residual sampling error averages out under the half
// resolution upsample instead of reading as salt and pepper.
float dofInterleavedGradientNoise(const float2 pixelPos, const uint frameIdx)
{
  // 5.588238 advances the pattern by a full unit of its own period each frame,
  // which decorrelates consecutive frames without repeating inside 64 frames.
  const float2 offsetPos = pixelPos + 5.588238f * float(frameIdx & 63u);
  return frac(52.9829189f * frac(dot(offsetPos, float2(0.06711056f, 0.00583715f))));
}

// Radial intensity profile of the blur disc, evaluated from the true
// normalized tap radius rather than the tap index. rtx.dof.bokehMinIntensity
// at its default of 1 leaves this an even disc; lowering it darkens the centre
// of the disc relative to its rim, which is the optical-vignetting "busy
// bokeh" look. The gather normalizes by the accumulated weight, so this
// changes the shape of the disc and never its total energy.
float dofBokehProfile(const float normalizedRadius)
{
  return lerp(saturate(cb.bokehMinIntensity), 1.0f, saturate(normalizedRadius));
}

// Fraction of this destination pixel covered by a source whose blur disc has
// radius sourceRadius and whose centre is distance apart. Zero radius covers
// nothing, and the one pixel ramp at the disc edge removes the hard ring a
// binary test leaves behind.
float dofDiscCoverage(const float sourceRadius, const float distance)
{
  return saturate(sourceRadius - distance);
}

// Projects a blur disc size in millimeters onto the output image and
// normalizes it to the maximum gather radius, so a normalized CoC of +-1 is
// exactly cb.maxGatherRadius pixels.
float dofLensCoCToNormalized(const float cocMm)
{
  const float maxRadiusPixels = max(cb.maxGatherRadius, 1e-4f);
  return min(cocMm * cb.sensorToPixels, maxRadiusPixels) / maxRadiusPixels;
}

float dofCalculateCircleOfConfusion(const float viewDepth, const float focusDistance)
{
  // Thin-lens blur disc size based on [Lee2008], as popularized by
  // CinematicDOF (Frans Bouma):
  //   CoC[mm] = ((f^2 / N) / (Zf - f)) * |Z - Zf| / Z
  // with focal length f and aperture f-number N as artistic lens parameters.
  // The hyperbolic 1/Z falloff grows continuously from the focus plane and
  // asymptotes in the far field, so there are no focus-band edges at all.
  const float focusDistanceMm = max(focusDistance * cb.worldUnitToMm, 1e-3f);
  const float viewDepthMm = max(viewDepth * cb.worldUnitToMm, 1e-3f);
  const float cocMm = cb.apertureTerm / max(focusDistanceMm - cb.focalLength, 1.0f)
    * abs(viewDepthMm - focusDistanceMm) / viewDepthMm;
  const float normalizedCoC = dofLensCoCToNormalized(cocMm);

  // The sign carries depth ordering: the signed CoC is monotonically
  // increasing in view depth, which lets the gather compare two taps' relative
  // depth without re-fetching the depth buffer.
  return viewDepth < focusDistance ? -normalizedCoC : normalizedCoC;
}

bool dofIsMissDepth(const float rawViewDepth)
{
  return rawViewDepth == cb.missLinearViewZ || abs(rawViewDepth) == cb.missLinearViewZ;
}

float dofGetCoCFromViewDepth(const float rawViewDepth, const float focusDistance)
{
  const float viewDepth = abs(rawViewDepth);

  // The denoiser's miss value is a far-field sentinel. Sky sits at infinity,
  // where the lens curve asymptotes to apertureTerm / (Zf - f): focusing far
  // away leaves the sky nearly sharp instead of always fully blurred.
  if (dofIsMissDepth(rawViewDepth))
  {
    const float focusDistanceMm = max(focusDistance * cb.worldUnitToMm, 1e-3f);
    return dofLensCoCToNormalized(cb.apertureTerm / max(focusDistanceMm - cb.focalLength, 1.0f));
  }

  return dofCalculateCircleOfConfusion(viewDepth, focusDistance);
}

#ifdef POST_FX_DOF_USE_LINEAR_VIEW_Z
// Point fetch of one render resolution linear view Z texel, clamped to the
// buffer.
//
// Depth is deliberately never bilinear filtered: an interpolated depth across
// a silhouette belongs to no surface, and the CoC computed from it produces a
// ring of wrong blur radius along every edge in the frame. Every depth read in
// the depth-of-field passes goes through here, so that property holds by
// construction; anything that wants a smooth result interpolates weights over
// several of these point samples instead.
float dofLoadViewDepthTexel(const int2 texel)
{
  const int2 maxTexel = int2(cb.linearViewZSize) - 1;
  return PrimaryLinearViewZ.Load(int3(clamp(texel, int2(0, 0), maxTexel), 0));
}

// The render resolution texel a full resolution pixel index lands in.
float dofLoadViewDepth(const uint2 fullResPixel)
{
  return dofLoadViewDepthTexel(
    int2((float2(fullResPixel) + 0.5f) * cb.inputOverOutputViewSize));
}
#endif

#ifdef POST_FX_DOF_USE_FOCUS_STATE
// Auto focus writes a persistent 1x1 R32_SFLOAT image from a 1x1x1 dispatch
// earlier in the same command buffer; this reads it with no host round trip.
float dofGetFocusDistance()
{
  return max(cb.autoFocusEnabled != 0
    ? FocusState[0] + cb.autoFocusOffset
    : cb.focusDistance, 1e-4f);
}
#endif

#ifdef POST_FX_DOF_USE_SURFACE_FLAGS
#include "rtx/pass/post_fx/post_fx_motion_blur_geometry_flags.slangh"

// The view model - the player's weapon and hands - is drawn a few centimetres
// from the lens, so a physically correct thin lens buries it under the largest
// circle of confusion in the frame and the near field it splats covers much of
// the screen. That is a real lens answering a question no camera operator would
// ask, so this holds the view model at zero CoC instead.
//
// In the prepare pass zero CoC is the entire exclusion, in both directions: a
// gather tap only reaches a neighbour when its own CoC covers that neighbour,
// so a zero radius stops the view model being blurred and stops it bleeding
// outward with one flag. It also drops out of the per tile radii, which is why
// this tends to buy back time rather than cost it.
//
// The flags image is the same render resolution G-buffer as linear view Z, so
// it is addressed and clamped exactly like the depth, and point sampled for the
// same reason: an interpolated flag belongs to no surface.
bool dofIsExcludedViewModelTexel(const int2 texel)
{
  if (cb.excludeViewModel == 0u)
  {
    return false;
  }

  const int2 maxTexel = int2(cb.linearViewZSize) - 1;

  return motionBlurSurfaceFlagsReadFromGBuffer(
    PrimarySurfaceFlags.Load(int3(clamp(texel, int2(0, 0), maxTexel), 0))).isViewModel;
}

// The render resolution texel a full resolution pixel index lands in - the same
// mapping dofLoadViewDepth() uses.
bool dofIsExcludedViewModel(const uint2 fullResPixel)
{
  return dofIsExcludedViewModelTexel(
    int2((float2(fullResPixel) + 0.5f) * cb.inputOverOutputViewSize));
}
#endif
