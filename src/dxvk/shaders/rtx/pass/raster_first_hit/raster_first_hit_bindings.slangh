#pragma once

#include "rtx/pass/raster_first_hit/raster_first_hit_binding_indices.h"

layout(push_constant)
ConstantBuffer<RasterFirstHitArgs> rasterArgs;

layout(binding = RASTER_FIRST_HIT_BINDING_DRAW_RECORDS)
StructuredBuffer<RasterFirstHitDrawRecord> RasterDrawRecords;

#if defined(RASTER_FIRST_HIT_CULL_PASS) || defined(RASTER_FIRST_HIT_HISTORY_PASS)
layout(binding = RASTER_FIRST_HIT_BINDING_VISIBILITY_HISTORY)
RWStructuredBuffer<uint> RasterVisibilityHistory;

layout(binding = RASTER_FIRST_HIT_BINDING_VISIBILITY_CURRENT)
RWStructuredBuffer<uint> RasterVisibilityCurrent;
#endif

#ifdef RASTER_FIRST_HIT_CULL_PASS
layout(binding = RASTER_FIRST_HIT_BINDING_DRAW_ARGS)
RWStructuredBuffer<uint> RasterDrawArgs;

layout(binding = RASTER_FIRST_HIT_BINDING_DRAW_COUNTS)
RWStructuredBuffer<uint> RasterDrawCounts;

layout(binding = RASTER_FIRST_HIT_BINDING_RECORD_STATE)
RWStructuredBuffer<uint> RasterRecordState;

layout(binding = RASTER_FIRST_HIT_BINDING_INSTANCE_BUFFER)
ByteAddressBuffer RasterTlasInstances;

layout(binding = RASTER_FIRST_HIT_BINDING_HIZ_INPUT)
Texture2D<float> RasterHiz;
#endif

#ifdef RASTER_FIRST_HIT_HIZ_PASS
layout(binding = RASTER_FIRST_HIT_BINDING_HIZ_SOURCE)
Texture2D<float> RasterHizSource;

layout(r32f, binding = RASTER_FIRST_HIT_BINDING_HIZ_OUTPUT)
RWTexture2D<float> RasterHizOutput;
#endif
