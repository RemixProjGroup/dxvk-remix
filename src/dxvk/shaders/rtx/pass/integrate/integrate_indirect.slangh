// Returns true for query pixels and for training cells that have a path to trace this frame. A cell that has
// none is invalidated here, since nothing downstream would write its TrainingPathInfo slot.
bool nrcCombinedToGbufferPixelCoordinate(
  uvec2 combinedNrcCoordinate,
  out uvec2 gbufferPixelCoordinate,
  out bool isNrcUpdate)
{
  isNrcUpdate = false; 
  
#if ENABLE_NRC
  // Identify which NRC mode this thread index corresponds to
  isNrcUpdate = Nrc::isUpdatePixel(combinedNrcCoordinate, cb);
    
  if (isNrcUpdate)
  {
    const uvec2 nrcUpdatePixelCoordinate = Nrc::calculateUpdatePixelCoordinateFromCombinedCoordinate(combinedNrcCoordinate, cb);

    if (any(nrcUpdatePixelCoordinate >= cb.nrcArgs.activeTrainingDimensions))
    {
      gbufferPixelCoordinate = uvec2(-1, -1); // To avoid uninitialized variable warning
      return false;
    }

    if (cb.sparseRenderingArgs.resampledNrcTrainingPaths)
    {
      // An empty reservoir means no active pixel was selected for this training cell, so skip its training path.
      if (!Nrc::calculateNrcTrainingQueryPixel(
            nrcUpdatePixelCoordinate, NrcTrainingQueryReservoir, cb.nrcArgs, gbufferPixelCoordinate))
      {
        Nrc::invalidateNrcTrainingPath(nrcUpdatePixelCoordinate);

        gbufferPixelCoordinate = uvec2(-1, -1);
        return false;
      }
    }
    else
    {
      // Reached only when sparse rendering is inactive, so every lattice pixel has a current GBuffer.
      gbufferPixelCoordinate = Nrc::calculateTrainingPixelCoordinateInQuerySpace(nrcUpdatePixelCoordinate, cb.nrcArgs);
    }

    // Update rows skip the query-space bounds check the caller runs, so a cell whose coordinate lands outside the
    // render extent has to be invalidated here rather than read out of bounds.
    if (any(gbufferPixelCoordinate >= cb.camera.resolution))
    {
      Nrc::invalidateNrcTrainingPath(nrcUpdatePixelCoordinate);

      gbufferPixelCoordinate = uvec2(-1, -1);
      return false;
    }
  }
  else
  {
    gbufferPixelCoordinate = combinedNrcCoordinate;
    gbufferPixelCoordinate.y -= cb.nrcArgs.numRowsForUpdate;
  }
#else
  gbufferPixelCoordinate = combinedNrcCoordinate;
#endif

  return true;
}

#if SHARC_UPDATE
// Returns the bits of an active-pixel mask block that lie inside the pixel rectangle [rectMin, rectEnd).
uint sharcTileMaskBits(uvec2 block, uvec2 rectMin, uvec2 rectEnd)
{
  const uvec2 blockSize = uvec2(ACTIVE_PIXEL_MASK_BLOCK_WIDTH, ACTIVE_PIXEL_MASK_BLOCK_HEIGHT);
  const uvec2 blockMin = block * blockSize;
  const uvec2 localMin = max(rectMin, blockMin) - blockMin;
  const uvec2 localEnd = min(rectEnd, blockMin + blockSize) - blockMin;
  const uint rowBits = ((1u << localEnd.x) - 1u) & ~((1u << localMin.x) - 1u);

  uint insideBits = 0u;
  for (uint y = localMin.y; y < localEnd.y; ++y)
  {
    insideBits |= rowBits << (y * ACTIVE_PIXEL_MASK_BLOCK_WIDTH);
  }

  return SparseRenderingActivePixelMask[block] & insideBits;
}

// Picks the update's source pixel among the pixels of the rectangle [rectMin, rectEnd) that sparse rendering
// shaded this frame. The pick selects the active pixel, counted in mask order, modulo their count.
// Returns false when the rectangle holds no active pixel.
bool sharcTileActivePixel(uvec2 rectMin, uvec2 rectEnd, uint pick, out uvec2 pixel)
{
  pixel = rectMin;

  const uvec2 blockSize = uvec2(ACTIVE_PIXEL_MASK_BLOCK_WIDTH, ACTIVE_PIXEL_MASK_BLOCK_HEIGHT);
  const uvec2 blockMin = rectMin / blockSize;
  const uvec2 blockEnd = (rectEnd + blockSize - 1u) / blockSize;

  uint activeCount = 0u;
  for (uint by = blockMin.y; by < blockEnd.y; ++by)
  {
    for (uint bx = blockMin.x; bx < blockEnd.x; ++bx)
    {
      activeCount += countbits(sharcTileMaskBits(uvec2(bx, by), rectMin, rectEnd));
    }
  }

  if (activeCount == 0u)
  {
    return false;
  }

  uint remaining = pick % activeCount;
  for (uint by = blockMin.y; by < blockEnd.y; ++by)
  {
    for (uint bx = blockMin.x; bx < blockEnd.x; ++bx)
    {
      uint bits = sharcTileMaskBits(uvec2(bx, by), rectMin, rectEnd);
      const uint bitCount = countbits(bits);
      if (remaining >= bitCount)
      {
        remaining -= bitCount;
        continue;
      }

      for (uint i = 0u; i < remaining; ++i)
      {
        bits &= bits - 1u;
      }

      const uint bitIndex = firstbitlow(bits);
      pixel = uvec2(bx, by) * blockSize + uvec2(bitIndex % ACTIVE_PIXEL_MASK_BLOCK_WIDTH, bitIndex / ACTIVE_PIXEL_MASK_BLOCK_WIDTH);
      return true;
    }
  }

  return false;
}
#endif

// Returns true if this is an active pixel
// Returns false if the thread should terminate
bool initPixelCoordinateOnLaunch(inout uvec2 gbufferPixelCoordinate, out bool isNrcUpdate)
{
  isNrcUpdate = false;
#if SHARC_UPDATE
  // The update dispatch is tile sized rather than screen sized. One rotating source pixel per tile
  // lets the cache see the whole view over time without NRC's expanded coordinate space.
  const uint tileSize = max(cb.sharcArgs.updateTileSize, 1u);
  const uvec2 tileCount = (cb.camera.resolution + tileSize - 1u) / tileSize;
  if (any(gbufferPixelCoordinate >= tileCount))
  {
    return false;
  }

  const uvec2 tile = gbufferPixelCoordinate;
  const uvec2 tileOffset = sharcTileOffset(tile, tileSize);
  gbufferPixelCoordinate = min(tile * tileSize + tileOffset,
                               cb.camera.resolution - 1u);

  // A pixel sparse rendering did not shade this frame holds an older frame's continuation, so the update takes one
  // of the tile's shaded pixels where it has any, and keeps its own choice otherwise.
  // The rotating slot also picks among the shaded pixels, so the tile still varies its source pixel every frame.
  if (cb.sharcArgs.updatePicksActivePixel && cb.sparseRenderingArgs.mode != SparseRenderingMode::Off &&
      !isActivePixelFromMask(SparseRenderingActivePixelMask, gbufferPixelCoordinate))
  {
    const uvec2 tileMin = tile * tileSize;
    const uvec2 tileEnd = min(tileMin + tileSize, cb.camera.resolution);
    uvec2 activePixel;
    if (sharcTileActivePixel(tileMin, tileEnd, tileOffset.y * tileSize + tileOffset.x, activePixel))
    {
      gbufferPixelCoordinate = activePixel;
    }
  }

  // Performance mode's update schedule skips the tiles of unscheduled blocks, except where the source pixel shows a moving surface.
  if (!sharcUpdateTileScheduled(tile) && !sharcUpdateSurfaceMoves(SharedSurfaceIndex[gbufferPixelCoordinate]))
  {
    return false;
  }
  return true;
#else
  if (!nrcCombinedToGbufferPixelCoordinate(
      gbufferPixelCoordinate,
      gbufferPixelCoordinate,
      isNrcUpdate))
  {
    return false;
  }

  // NRC training threads have dedicated valid coords (already validated against activeTrainingDimensions)
  // that are not remapped on sparse rendering
  if (isNrcUpdate)
  {
    return true;
  }

  // Bounds-check before any per-pixel texture reads
  if (any(gbufferPixelCoordinate >= cb.camera.resolution))
  {
    return false;
  }

  return loadPixelCoordinate(gbufferPixelCoordinate, ActiveLocalPixelCoords,
                             cb.camera.resolution, cb.sparseRenderingArgs, gbufferPixelCoordinate);
#endif
}

void integrate_indirect_pass(uvec2 threadIndex)
{
  uvec2 gbufferPixelCoordinate = threadIndex;

  bool isNrcUpdate = false;

  if (!initPixelCoordinateOnLaunch(gbufferPixelCoordinate, isNrcUpdate))
  {
    return;
  }

  // Deserialize flags

  const GeometryFlags geometryFlags = geometryFlagsReadFromGBuffer(gbufferPixelCoordinate, SharedFlags);

  // Check if the GBuffer was hit on the Primary and Secondary surfaces

  const bool primaryGBufferMiss = isGBufferMiss(gbufferPixelCoordinate, PrimaryConeRadius);
  const bool secondaryGBufferMiss = isGBufferMiss(gbufferPixelCoordinate, SecondaryConeRadius);

  // Write out empty data
  // Note: This should hopefully prevent any weird undefined data from bleeding into pixels actually being denoised, but
  // may not be needed depending on how the denoiser works.

  bool gbufferMissOfASelectedIntegrationSurface = 
    geometryFlags.primarySelectedIntegrationSurface
    ? primaryGBufferMiss 
    : secondaryGBufferMiss;

  // Note: Early out if no more work on the active surface is needed.
  if (gbufferMissOfASelectedIntegrationSurface)
  {
    if (isNrcUpdate || SHARC_UPDATE)
    {
      // IndirectRadianceHitDistance is not used for update pixels, so no need to write it out
      return;
    }

    IndirectRadianceHitDistance[gbufferPixelCoordinate] = vec4(vec3(0), kEmptyPixelHitDistance);

    return;
  }

  // Read the medium material index

  const uint mediumMaterialIndex = SharedMediumMaterialIndex[gbufferPixelCoordinate];

  // Load state data carried over from the direct integration pass

  const vec4 rayOriginDirection = RayOriginDirection[gbufferPixelCoordinate];
  const vec4 throughputConeRadius = ThroughputConeRadius[gbufferPixelCoordinate];
  IndirectSampleData indirectSampleData;
  indirectSampleData.load(gbufferPixelCoordinate, FirstSampledLobeData);

  const vec3 rayOrigin = rayOriginDirection.xyz;
  const vec3 rayDirection = signedOctahedralToSphereDirection(snorm2x16ToFloat2x32(floatBitsToUint(rayOriginDirection.w)));
  const vec3 throughput = throughputConeRadius.xyz;
  const float coneRadius = throughputConeRadius.w;
  const float firstHitPerceptualRoughness = FirstHitPerceptualRoughness[gbufferPixelCoordinate];
  const float firstSampledLobePdf = indirectSampleData.firstSampledLobePdf;
  const float firstSampledSolidAnglePdf = indirectSampleData.firstSampledSolidAnglePdf;

  const float gbufferSurfaceHitDistance = calculateSelectedIntegrationSurfaceHitDistance(
    ivec2(gbufferPixelCoordinate), geometryFlags, PrimaryHitDistance, SecondaryHitDistance);

  // Integrate the Indirect portion of the Path

  IndirectPathTextures indirectPathTextures;

  indirectPathTextures.PrimaryWorldPositionWorldTriangleNormal = PrimaryWorldPositionWorldTriangleNormal;
  indirectPathTextures.IndirectRadianceHitDistance = IndirectRadianceHitDistance;
  
  integrateIndirectPath(
    gbufferPixelCoordinate, INTEGRATE_INDIRECT_SBT_OFFSET_STANDARD, indirectPathTextures,
    geometryFlags, mediumMaterialIndex, rayOrigin, rayDirection,
    throughput, coneRadius, firstHitPerceptualRoughness,
    firstSampledLobePdf, firstSampledSolidAnglePdf, gbufferSurfaceHitDistance, isNrcUpdate);
}
