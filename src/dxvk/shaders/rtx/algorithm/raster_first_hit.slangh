#pragma once

// Vertex fetches shared by the raster first hit's vertex shader and the G-buffer pass that reads its visibility
// buffer. They read the buffers the Surface record names, the same way surfaceInteractionCreate does, so the raster
// triangles are the triangles the rays intersect. The including pass provides the common bindings.

#include "rtx/pass/raster_first_hit/raster_first_hit_binding_indices.h"

// Returns the vertex index of one corner of a triangle of a surface.
uint rasterFirstHitVertexIndex(Surface surface, uint primitiveIndex, uint corner)
{
  const uint indexIndex = primitiveIndex * 3 + corner + surface.firstIndex;

  if (surface.indexBufferIndex == BINDING_INDEX_INVALID)
  {
    return indexIndex;
  }

  if (surface.indexStride == 4)
  {
    return BUFFER_ARRAY(indices32, surface.indexBufferIndex, indexIndex);
  }

  return BUFFER_ARRAY(indices, surface.indexBufferIndex, indexIndex);
}

// Returns the object space position of a vertex of a surface.
vec3 rasterFirstHitObjectPosition(Surface surface, uint vertexIndex)
{
  const uint positionBufferIndex = surface.positionBufferIndex;
  const uint positionElementIndex = (vertexIndex * uint(surface.positionStride) + surface.positionOffset) / 4;

  return vec3(
    BUFFER_ARRAY(geometries, positionBufferIndex, positionElementIndex + 0),
    BUFFER_ARRAY(geometries, positionBufferIndex, positionElementIndex + 1),
    BUFFER_ARRAY(geometries, positionBufferIndex, positionElementIndex + 2));
}

// Returns an object space position relative to the camera in world space. The translation and the camera position
// are subtracted before the rotation is added, which keeps the precision of far from the origin geometry.
vec3 rasterFirstHitCameraRelativePosition(Surface surface, vec3 objectPosition, vec3 cameraPosition)
{
  const mat4x3 objectToWorld = surface.objectToWorld;
  const vec3 translation = vec3(objectToWorld[0].w, objectToWorld[1].w, objectToWorld[2].w) - cameraPosition;

  return vec3(
    dot(objectToWorld[0].xyz, objectPosition),
    dot(objectToWorld[1].xyz, objectPosition),
    dot(objectToWorld[2].xyz, objectPosition)) + translation;
}

// Returns whether a triangle with these camera-relative corners faces a ray along rayDirection, by the rule of
// Vulkan ray tracing: the triangle faces the ray when its winding normal points against it, unless the instance flips
// the facing.
bool rasterFirstHitIsFrontFacing(vec3 p0, vec3 p1, vec3 p2, vec3 rayDirection, bool flipFacing)
{
  const vec3 windingNormal = cross(p1 - p0, p2 - p0);

  return (dot(windingNormal, rayDirection) < 0.0f) != flipFacing;
}
