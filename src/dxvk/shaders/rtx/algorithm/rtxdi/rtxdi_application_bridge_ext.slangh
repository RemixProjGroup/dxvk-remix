#pragma once

// Includes NVIDIA's RTXDI application bridge (RtxdiApplicationBridge.slangh), which is used unmodified, and wraps some
// of its RAB_ functions. While the bridge is included, those functions are renamed with a Base suffix, and the wrappers
// below take the original names, so the RTXDI SDK and the passes call the wrappers.
// Calls from one bridge function to another inside the bridge resolve to the Base versions.
// Nothing included by the bridge may call a renamed function, or that call would skip its wrapper.

#define RAB_GetLightSample RAB_GetLightSampleBase
#define RAB_GetPortalSpaceLightSample RAB_GetPortalSpaceLightSampleBase
#define RAB_LoadReservoir RAB_LoadReservoirBase
#if VOLUME_LIGHT_SAMPLE_CLOUD_SHADOW
#define RAB_GetLightSampleWithTypeHint RAB_GetLightSampleWithTypeHintBase
#endif
#ifdef RESTIR_GI_PREVIOUS_FRAME_PAGE
#define RAB_LoadGIReservoir RAB_LoadGIReservoirBase
#endif
#ifdef LIGHT_BVH_SELECT_NO_SUBSURFACE
#define RAB_GetGBufferSurface RAB_GetGBufferSurfaceBase
#endif

#include "rtx/algorithm/rtxdi/RtxdiApplicationBridge.slangh"

#undef RAB_GetLightSample
#undef RAB_GetPortalSpaceLightSample
#undef RAB_LoadReservoir
#undef RAB_GetLightSampleWithTypeHint
#undef RAB_LoadGIReservoir
#undef RAB_GetGBufferSurface

#if VOLUME_LIGHT_SAMPLE_CLOUD_SHADOW
#include "rtx/algorithm/sky_provider.slangh"
#endif

#ifdef LIGHT_BVH_SELECT_NO_SUBSURFACE
// Bound only while no thin-opaque material exists and no diffusion-profile instance is in the scene, where the G-buffer
// holds the no-subsurface encoding for every pixel. The subsurface interaction is that encoding's decode, so the
// subsurface G-buffer and the surface material are not read.
// The decode is all zeros, as RAB_EmptySurface sets it, so it also holds for the surfaces the bridge returns early.
RAB_Surface RAB_GetGBufferSurface(ivec2 pixel, bool previousFrame)
{
  RAB_Surface surface = RAB_GetGBufferSurfaceBase(pixel, previousFrame);
  surface.opaqueSurfaceMaterialInteraction.subsurfaceMaterialInteraction = subSurfaceMaterialReadHelper(uint2(0u, 0u), uint2(0u, 0u));
  return surface;
}
#endif

// The reservoir buffer is zero-filled on creation, and a zero record would unpack as a valid reservoir for light 0.
// Sparse rendering reuses pixels that have not written a reservoir since then, so a zero record is read as empty.
// A written reservoir for light 0 is not affected, since holding a sample makes its M at least 1, which keeps data1 nonzero.
RTXDI_Reservoir RAB_LoadReservoir(int2 pixel, int page)
{
#ifdef RAB_HAS_RTXDI_RESERVOIRS
  const RTXDI_PackedReservoir packedReservoir = RtxdiReservoirBuffer[RTXDI_ReservoirPositionToPointer(pixel, cb.camera.resolution, page)];
  if (all((packedReservoir.data0 | packedReservoir.data1) == 0u))
  {
    return RTXDI_EmptyReservoir();
  }

  return RTXDI_UnpackReservoir(packedReservoir);
#else
  return RTXDI_EmptyReservoir();
#endif
}

#ifdef RESTIR_GI_PREVIOUS_FRAME_PAGE
ReSTIRGI_Reservoir RAB_LoadGIReservoir(int2 pixel, int page)
{
  ReSTIRGI_Reservoir reservoir = RAB_LoadGIReservoirBase(pixel, page);
#ifdef RAB_HAS_RESTIR_GI_RESERVOIRS
  // A pass that runs before this frame's reservoirs replace the previous frame's (the temporal reuse) reads
  // radiance at the previous pre-exposure on this page (rtx_pre_exposure.h).
  if (page == RESTIR_GI_PREVIOUS_FRAME_PAGE)
  {
    reservoir.radiance *= cb.preExposureHistoryRatio;
  }
#endif
  return reservoir;
}
#endif

#if VOLUME_LIGHT_SAMPLE_CLOUD_SHADOW
// Multiplies a volume light sample of a light the sky provider marks cloud-shadowed (the sun and moons)
// by the cloud transmittance toward the light, so the froxel cache keeps the clouds' shadows.
// Only the volume integrate pass enables it, so the volume ReSTIR passes resample without it.
void applyVolumeLightSampleCloudShadow(inout RAB_LightSample lightSample, DecodedPolymorphicLight light, RAB_VolumeInteraction volumeInteraction)
{
  if (!skyProviderActive() || !light.atmosphereCloudShadowed)
  {
    return;
  }

  const vec3 position = volumeInteraction.volumeInteraction.position;
  lightSample.radiance *= skyProviderCloudShadow(position, normalize(lightSample.position - position));
}
#endif

// A sample of the previous frame's lights is encoded at the previous pre-exposure (rtx_pre_exposure.h).
// The wrappers below bring it to this frame's pre-exposure.

RAB_LightSample RAB_GetLightSample(uint lightID, float2 lightUV, MinimalSurfaceInteraction minimalSurfaceInteraction, bool usePreviousLights = false)
{
  RAB_LightSample lightSample = RAB_GetLightSampleBase(lightID, lightUV, minimalSurfaceInteraction, usePreviousLights);
  if (usePreviousLights)
  {
    lightSample.radiance *= cb.preExposureHistoryRatio;
  }
  return lightSample;
}

RAB_LightSample RAB_GetLightSample(uint lightID, float2 lightUV, RAB_Surface surface, bool usePreviousLights = false)
{
  return RAB_GetLightSample(lightID, lightUV, surface.minimalSurfaceInteraction, usePreviousLights);
}

RAB_LightSample RAB_GetLightSample(uint lightID, float2 lightUV, RAB_VolumeInteraction volumeInteraction, bool usePreviousLights = false)
{
  RAB_LightSample lightSample = RAB_GetLightSampleBase(lightID, lightUV, volumeInteraction, usePreviousLights);
  if (usePreviousLights)
  {
    lightSample.radiance *= cb.preExposureHistoryRatio;
  }
#if VOLUME_LIGHT_SAMPLE_CLOUD_SHADOW
  applyVolumeLightSampleCloudShadow(lightSample, decodePolymorphicLight(RAB_GetMemoryPolymorphicLight(lightID, usePreviousLights)), volumeInteraction);
#endif
  return lightSample;
}

#if VOLUME_LIGHT_SAMPLE_CLOUD_SHADOW
RAB_LightSample RAB_GetLightSampleWithTypeHint(uint lightID, float2 lightUV, uint lightType, RAB_Surface surface)
{
  return RAB_GetLightSampleWithTypeHintBase(lightID, lightUV, lightType, surface);
}

RAB_LightSample RAB_GetLightSampleWithTypeHint(uint lightID, float2 lightUV, uint lightType, RAB_VolumeInteraction volumeInteraction)
{
  RAB_LightSample lightSample = RAB_GetLightSampleWithTypeHintBase(lightID, lightUV, lightType, volumeInteraction);
  applyVolumeLightSampleCloudShadow(lightSample, RAB_GetDecodedPolymorphicLightWithTypeHint(lightID, lightType), volumeInteraction);
  return lightSample;
}
#endif

// The light sample is taken in the light's space and its position moved to portal space, which leaves the radiance as is.
RAB_LightSample RAB_GetPortalSpaceLightSample(uint lightIdx, float2 lightUV, uint8_t portalIdx, MinimalSurfaceInteraction minimalSurfaceInteraction, bool usePreviousLights = false)
{
  RAB_LightSample lightSample = RAB_GetPortalSpaceLightSampleBase(lightIdx, lightUV, portalIdx, minimalSurfaceInteraction, usePreviousLights);
  if (usePreviousLights)
  {
    lightSample.radiance *= cb.preExposureHistoryRatio;
  }
  return lightSample;
}

RAB_LightSample RAB_GetPortalSpaceLightSample(uint lightIdx, float2 lightUV, uint8_t portalIdx, RAB_Surface surface, bool usePreviousLights = false)
{
  return RAB_GetPortalSpaceLightSample(lightIdx, lightUV, portalIdx, surface.minimalSurfaceInteraction, usePreviousLights);
}
