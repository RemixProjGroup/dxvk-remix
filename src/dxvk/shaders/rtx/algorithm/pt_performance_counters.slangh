#pragma once

// Adds to performance mode's counters (rtx/pass/pt_performance_counters.h), aggregated per wave.
// Needs common_bindings.slangh (cb and LightSamplingStats).

#include "rtx/pass/pt_performance_counters.h"

// Counts the lanes of the wave for which the condition holds.
void ptPerformanceCounterAdd(uint slot, bool condition)
{
  if (!cb.ptPerformanceCounters)
  {
    return;
  }

  const uint count = WaveActiveCountBits(condition);
  if (count != 0u && WaveIsFirstLane())
  {
    InterlockedAdd(LightSamplingStats[PT_PERFORMANCE_COUNTER_BASE + slot], count);
  }
}
