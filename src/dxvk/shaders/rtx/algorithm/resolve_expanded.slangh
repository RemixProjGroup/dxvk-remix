// Note: Temporary hack file to expand resolve.slangh and ray.slangh macros
// as the GLSL compiler has issues. Do not touch the file unless you know
// what you're doing.
#pragma once

#include "rtx/utility/debug_view_helpers.slangh"
#include "rtx/algorithm/software_omm.slangh" // rtx.alphaBake.softwareOmmResolveSkip

// The resolve pass a shader's [SoftOmm] resolve counters go to, which also picks the per-pass switch that gates the skip
// (softOmmResolveSkipActive). geometry_resolver.slangh and integrator_indirect.slangh define it before their resolve loops.
#ifndef SOFT_OMM_RESOLVE_PASS_ID
#define SOFT_OMM_RESOLVE_PASS_ID SOFT_OMM_RESOLVE_PASS_OTHER
#endif
// The traversal pass whose rtx.alphaBake.softwareOmmTraversal bit gates the ray query candidate loop (softOmmTraversalActive).
// OTHER never acts. The same files as SOFT_OMM_RESOLVE_PASS_ID define it.
#ifndef SOFT_OMM_TRAVERSAL_PASS_ID
#define SOFT_OMM_TRAVERSAL_PASS_ID SOFT_OMM_TRAVERSAL_PASS_OTHER
#endif

// Use this macro as the 'segmentHitDistance' parameter to the RESOLVE_XX macros when shortening the ray is unnecessary
#define SEGMENT_HIT_DISTANCE_UNUSED 0

#ifdef RT_SHADER_EXECUTION_REORDERING

// Adds a coherence hint to the lowest/least important bit
void addCoherenceHintAsLeastImportant1Bit(uint coherenceHintToAdd, inout uint coherenceHints, inout uint numCoherenceHints)
{
  coherenceHints = coherenceHintToAdd | (coherenceHints << 1);
  ++numCoherenceHints;
}

// Use unique Reorder IDs in coherence hints to distinguish ReorderThread callsites
#if 0 // Currently ReorderThread is only called right before InvokeHitObject so this is not needed yet
#define SER_REORDER_ID_INTEGRATE_TRACERAY 0
#define SER_REORDER_ID_INTEGRATE_CUSTOM 1
#define SER_REORDER_ID_NUM_BITS 1

// Must be called last
void addGlobalReorderIDCoherenceHint(inout uint coherenceHint, inout uint numCoherenceHintBits, uint reorderID)
{
  coherenceHint = reorderID | (coherenceHint << SER_REORDER_ID_NUM_BITS);
  numCoherenceHintBits += SER_REORDER_ID_NUM_BITS;
}
#endif

void TraceRayCustom<payload_t : IBasePayloadState>(
    RaytracingAccelerationStructure accelerationStructure,
    uint                            rayFlags,
    uint                            rayMask,
    uint                            sbtRecordOffset,
    uint                            sbtRecordStride,
    uint                            missIndex,
    RayDesc                         ray,
    inout payload_t                 payload)
{   
  HitObject hitObject = HitObject::TraceRay(                                                                     
    accelerationStructure,                                                                       
    rayFlags, rayMask,                                
    sbtRecordOffset, sbtRecordStride,                                                           
    missIndex, ray,                                                                          
    payload                                                                          
  );  

  uint numCoherenceHints;
  uint coherenceHints;

  if (payload.shouldReorder(coherenceHints, numCoherenceHints))
  {
    // rtx.serSurfaceCoherenceHintBits. Every hit uses the same closest-hit shader, so SER can only sort on hit
    // vs miss plus the payload's 0-2 bits. This appends a key read from the hit object without memory access:
    // the material type, then the low bits of surface index + geometry index, where the geometry index separates
    // the members of a merged BLAS. The most significant hint bits are the most important.
    const uint surfaceHintBits = min(cb.serSurfaceCoherenceHintBits, 16u - numCoherenceHints);
    if (surfaceHintBits >= 3u)
    {
      uint surfaceHint = 0u;
      if (hitObject.IsHit())
      {
        const uint customIndex = hitObject.GetInstanceID();
        const uint materialType = (customIndex & CUSTOM_INDEX_MATERIAL_TYPE_MASK) >> CUSTOM_INDEX_MATERIAL_TYPE_BIT;
        const uint surfaceKey = (customIndex & CUSTOM_INDEX_SURFACE_MASK) + hitObject.GetGeometryIndex();
        const uint surfaceKeyBits = surfaceHintBits - 2u;
        surfaceHint = (materialType << surfaceKeyBits) | (surfaceKey & ((1u << surfaceKeyBits) - 1u));
      }
      coherenceHints = (coherenceHints << surfaceHintBits) | surfaceHint;
      numCoherenceHints += surfaceHintBits;
    }

    // addGlobalReorderIDCoherenceHint(coherenceHints, numCoherenceHints, SER_REORDER_ID_INTEGRATE_TRACERAY);
    ReorderThread(hitObject, coherenceHints, numCoherenceHints);
  }

  HitObject::Invoke(accelerationStructure, hitObject, payload);
}

#else  // !defined(RT_SHADER_EXECUTION_REORDERING)

void TraceRayCustom<payload_t : IBasePayloadState>(
    RaytracingAccelerationStructure accelerationStructure,
    uint                            rayFlags,
    uint                            rayMask,
    uint                            sbtRecordOffset,
    uint                            sbtRecordStride,
    uint                            missIndex,
    RayDesc                         ray,
    inout payload_t                 payload)
{
  TraceRay(                                                                      
    accelerationStructure,                                                                          
    rayFlags, rayMask,                                                       
    sbtRecordOffset,                                         
    sbtRecordStride,                                                          
    missIndex,                                                             
    ray,                                                                         
    payload); 
}

#endif

// rtx.resolveFinalInteractionSkipsNonOpaque. Every resolve iteration traces FORCE_OPAQUE and alpha-tests the
// closest hit itself, re-tracing past a transparent texel. The last iteration has nothing left to re-trace with,
// so it would keep a transparent cutout texel as the surface, shaded solid with the colour stored under its zero alpha.
// Dense cutouts seen at a low angle exhaust the budget routinely, so the last iteration skips non-opaque geometry
// and lands on the first opaque surface behind, or misses. A budget of 1 is left alone, because that single trace
// is the whole resolve.
uint resolveIterationRayFlags(uint flags, uint8_t interactionIteration, bool lastInteraction)
{
  if (lastInteraction && interactionIteration > uint8_t(1) &&
      cb.resolveFinalInteractionSkipsNonOpaque != 0 && (flags & RAY_FLAG_FORCE_OPAQUE) != 0)
  {
    return (flags & ~uint(RAY_FLAG_FORCE_OPAQUE)) | RAY_FLAG_CULL_NON_OPAQUE;
  }

  return flags;
}

#define RESOLVE_RAY_QUERY(                                                                \
  extraArgs, ray, flags, hitFunction, maxInteractions, payload, segmentHitDistance,       \
  interactionsDebugView1, interactionsDebugView2, allowWriteToInteractionsDebugViews)     \
{                                                                                         \
  /* Initialize the payload with the current ray's state */                               \
                                                                                          \
  RayDesc currentRay;                                                                     \
  currentRay.Origin = ray.origin;                                                         \
  currentRay.TMin = 0.f;                                                                  \
  currentRay.TMax = ray.tMax;                                                             \
  currentRay.Direction = ray.direction;                                                   \
                                                                                          \
  payload.origin = ray.origin;                                                            \
  payload.coneRadius = ray.coneRadius;                                                    \
  payload.direction = ray.direction;                                                      \
                                                                                          \
  /* Loop until a surface is resolved, or the maximum interaction count is hit */         \
  uint8_t interactionIteration;                                                           \
  for (interactionIteration = uint8_t(1);; ++interactionIteration)                        \
  {                                                                                       \
    /* Reset the hit distance used for Resolve logic for this next iteration */           \
                                                                                          \
    payload.continueResolving = interactionIteration < maxInteractions;                   \
                                                                                          \
    /* Preform the ray trace with the desired information */                              \
                                                                                          \
    /* Note: Live state across this call (not put into payload as it is not */            \
    /* needed for anything on the hit function side of things):             */            \
    /* - interactionIteration                                               */            \
    /* - currentRay.tMax                                                    */            \
                                                                                          \
    {                                                                                                   \
      /* Invoke a Ray Query */                                                                          \
                                                                                                        \
      RayQuery<0> rayQuery = RayQuery<0>();                                                             \
                                                                                                        \
      /* Note: For now gl_RayFlagsOpaqueEXT is always used as this function will always return the */   \
      /* closest geometry hit, translucent or not (as we handle things like translucency and opacity */ \
      /* manually and re-cast the ray afterwards). */                                                   \
      /* Note: Ray direction casted to vec3 to be consistent with how ray evaluation is done */         \
      /* (to minimize any discrepancy). */                                                              \
      /* rtx.alphaBake.softwareOmmResolveSkip may trace FORCE_OPAQUE in place of */       \
      /* CULL_NON_OPAQUE (softOmmResolveFlags) and re-trace past hits that hardware */    \
      /* micromaps would cull (software_omm.slangh). */                                   \
      /* rtx.alphaBake.softwareOmmTraversal drops FORCE_OPAQUE / CULL_NON_OPAQUE in a */  \
      /* pass whose bit is set and handles the non-opaque candidates below */             \
      /* (softOmmTraversalCommit). The skip re-trace loop is then off for that */         \
      /* iteration, because transparent hits are never committed. */                      \
      const uint softOmmRequestedFlags =                                                  \
        resolveIterationRayFlags(flags, interactionIteration, !payload.continueResolving);\
      uint softOmmTraversalMode;                                                          \
      uint softOmmSkipMode = SOFT_OMM_SKIP_NONE;                                          \
      uint softOmmTraceFlags = softOmmTraversalFlags(SOFT_OMM_TRAVERSAL_PASS_ID, softOmmRequestedFlags, softOmmTraversalMode); \
      if (softOmmTraversalMode == SOFT_OMM_TRAVERSAL_NONE)                                \
      {                                                                                   \
        softOmmTraceFlags = softOmmResolveFlags(SOFT_OMM_RESOLVE_PASS_ID, softOmmRequestedFlags, softOmmSkipMode); \
      }                                                                                   \
      rayQuery.TraceRayInline(                                                            \
        topLevelAS,                                                                       \
        softOmmTraceFlags,                                                                \
        uint(payload.rayMask),                                                            \
        currentRay                                                                        \
      );                                                                                  \
                                                                                          \
      while (rayQuery.Proceed())                                                          \
      {                                                                                   \
        if (softOmmTraversalMode != SOFT_OMM_TRAVERSAL_NONE)                              \
        {                                                                                 \
          if (rayQuery.CandidateType() == CANDIDATE_NON_OPAQUE_TRIANGLE)                  \
          {                                                                               \
            if (softOmmTraversalCommit(SOFT_OMM_TRAVERSAL_PASS_ID, softOmmTraversalMode,  \
                  rayQuery.CandidateInstanceID(), rayQuery.CandidateGeometryIndex(),      \
                  rayQuery.CandidatePrimitiveIndex(), rayQuery.CandidateTriangleBarycentrics())) \
            {                                                                             \
              rayQuery.CommitNonOpaqueTriangleHit();                                      \
            }                                                                             \
          }                                                                               \
        }                                                                                 \
      };                                                                                  \
                                                                                          \
      if (softOmmSkipMode != SOFT_OMM_SKIP_NONE)                                          \
      {                                                                                   \
        RayDesc softOmmRay = currentRay;                                                  \
        for (uint softOmmSkips = 0u; rayQuery.CommittedStatus() == COMMITTED_TRIANGLE_HIT; ++softOmmSkips) \
        {                                                                                 \
          const uint softOmmKind = softOmmResolveSkipKind(softOmmSkipMode,                \
            rayQuery.CommittedInstanceID(), rayQuery.CommittedGeometryIndex(),            \
            rayQuery.CommittedPrimitiveIndex(), rayQuery.CommittedTriangleBarycentrics()); \
          if (softOmmKind == 0u ||                                                        \
              (softOmmSkips >= SOFT_OMM_RESOLVE_MAX_SKIPS && softOmmSkipMode == SOFT_OMM_SKIP_TRANSPARENT)) \
          {                                                                               \
            if (softOmmKind != 0u)                                                        \
            {                                                                             \
              softOmmCountResolve(SOFT_OMM_RESOLVE_PASS_ID, SOFT_OMM_RESOLVE_COUNTER_CAP); \
            }                                                                             \
            break;                                                                        \
          }                                                                               \
          softOmmRay.TMin = softOmmNextRayT(rayQuery.CommittedRayT());                    \
          const bool softOmmAtCap = softOmmSkips >= SOFT_OMM_RESOLVE_MAX_SKIPS;           \
          softOmmCountResolve(SOFT_OMM_RESOLVE_PASS_ID, softOmmAtCap ? SOFT_OMM_RESOLVE_COUNTER_CAP : \
            (softOmmSkipMode == SOFT_OMM_SKIP_CULL_NON_OPAQUE ? SOFT_OMM_RESOLVE_COUNTER_NON_OPAQUE : SOFT_OMM_RESOLVE_COUNTER_TRANSPARENT)); \
          rayQuery.TraceRayInline(                                                        \
            topLevelAS,                                                                   \
            softOmmAtCap ? softOmmRequestedFlags : softOmmTraceFlags,                     \
            uint(payload.rayMask),                                                        \
            softOmmRay                                                                    \
          );                                                                              \
          while (rayQuery.Proceed())                                                      \
          {                                                                               \
          };                                                                              \
          if (softOmmAtCap)                                                               \
          {                                                                               \
            break;                                                                        \
          }                                                                               \
        }                                                                                 \
      }                                                                                   \
                                                                                          \
      /* Construct hit info from the hit */                                               \
      RAY_HIT_INFO_CREATE_RAY_QUERY_COMMITTED(rayHitInfo, rayQuery)                       \
                                                                                          \
      /* Call the hit function */                                                         \
      hitFunction(extraArgs, rayHitInfo, payload);                                        \
    }                                                                                     \
                                                                                          \
    /* Check if the resolve loop should continue */                                       \
                                                                                          \
    if (!payload.continueResolving)                                                       \
    {                                                                                     \
      break;                                                                              \
    }                                                                                     \
                                                                                          \
    /* Update current ray for next iteration */                                           \
                                                                                          \
    currentRay.Origin = payload.origin;                                                   \
    currentRay.Direction = payload.direction;                                             \
    currentRay.TMax = max(currentRay.TMax - segmentHitDistance, 0.0f);                    \
  }                                                                                       \
                                                                                          \
  if ((cb.debugView == interactionsDebugView1 || cb.debugView == interactionsDebugView2)  \
    && allowWriteToInteractionsDebugViews)                                                \
  {                                                                                       \
    accumulateInDebugViewAdd(payload.pixelCoordinate, interactionIteration);              \
  }                                                                                       \
}

// RESOLVE_RAY_QUERY with a first interaction that need not be traced: while useFirstHit is true, the first
// iteration hands firstHit (a RayHitInfo) to the hit function instead of tracing the ray, and the loop traces from
// the second iteration on. The hit function has one call site either way. The G-buffer pass uses it for the raster
// first hit (rtx.ptPerformance.firstHit).
#define RESOLVE_RAY_QUERY_WITH_FIRST_HIT(                                                                \
  extraArgs, ray, flags, hitFunction, maxInteractions, payload, segmentHitDistance,       \
  interactionsDebugView1, interactionsDebugView2, allowWriteToInteractionsDebugViews,      \
  useFirstHit, firstHit)                                                                  \
{                                                                                         \
  /* Initialize the payload with the current ray's state */                               \
                                                                                          \
  RayDesc currentRay;                                                                     \
  currentRay.Origin = ray.origin;                                                         \
  currentRay.TMin = 0.f;                                                                  \
  currentRay.TMax = ray.tMax;                                                             \
  currentRay.Direction = ray.direction;                                                   \
                                                                                          \
  payload.origin = ray.origin;                                                            \
  payload.coneRadius = ray.coneRadius;                                                    \
  payload.direction = ray.direction;                                                      \
                                                                                          \
  /* Loop until a surface is resolved, or the maximum interaction count is hit */         \
  uint8_t interactionIteration;                                                           \
  for (interactionIteration = uint8_t(1);; ++interactionIteration)                        \
  {                                                                                       \
    /* Reset the hit distance used for Resolve logic for this next iteration */           \
                                                                                          \
    payload.continueResolving = interactionIteration < maxInteractions;                   \
                                                                                          \
    /* Preform the ray trace with the desired information */                              \
                                                                                          \
    /* Note: Live state across this call (not put into payload as it is not */            \
    /* needed for anything on the hit function side of things):             */            \
    /* - interactionIteration                                               */            \
    /* - currentRay.tMax                                                    */            \
                                                                                          \
    {                                                                                                   \
      /* Invoke a Ray Query */                                                                          \
                                                                                                        \
      /* The first interaction may come from firstHit instead of a trace. */              \
      RayHitInfo rayHitInfo;                                                              \
      if (interactionIteration == uint8_t(1) && (useFirstHit))                            \
      {                                                                                   \
        rayHitInfo = (firstHit);                                                          \
      }                                                                                   \
      else                                                                                \
      {                                                                                   \
      RayQuery<0> rayQuery = RayQuery<0>();                                                             \
                                                                                                        \
      /* Note: For now gl_RayFlagsOpaqueEXT is always used as this function will always return the */   \
      /* closest geometry hit, translucent or not (as we handle things like translucency and opacity */ \
      /* manually and re-cast the ray afterwards). */                                                   \
      /* Note: Ray direction casted to vec3 to be consistent with how ray evaluation is done */         \
      /* (to minimize any discrepancy). */                                                              \
      /* rtx.alphaBake.softwareOmmResolveSkip may trace FORCE_OPAQUE in place of */       \
      /* CULL_NON_OPAQUE (softOmmResolveFlags) and re-trace past hits that hardware */    \
      /* micromaps would cull (software_omm.slangh). */                                   \
      /* rtx.alphaBake.softwareOmmTraversal drops FORCE_OPAQUE / CULL_NON_OPAQUE in a */  \
      /* pass whose bit is set and handles the non-opaque candidates below */             \
      /* (softOmmTraversalCommit). The skip re-trace loop is then off for that */         \
      /* iteration, because transparent hits are never committed. */                      \
      const uint softOmmRequestedFlags =                                                  \
        resolveIterationRayFlags(flags, interactionIteration, !payload.continueResolving);\
      uint softOmmTraversalMode;                                                          \
      uint softOmmSkipMode = SOFT_OMM_SKIP_NONE;                                          \
      uint softOmmTraceFlags = softOmmTraversalFlags(SOFT_OMM_TRAVERSAL_PASS_ID, softOmmRequestedFlags, softOmmTraversalMode); \
      if (softOmmTraversalMode == SOFT_OMM_TRAVERSAL_NONE)                                \
      {                                                                                   \
        softOmmTraceFlags = softOmmResolveFlags(SOFT_OMM_RESOLVE_PASS_ID, softOmmRequestedFlags, softOmmSkipMode); \
      }                                                                                   \
      rayQuery.TraceRayInline(                                                            \
        topLevelAS,                                                                       \
        softOmmTraceFlags,                                                                \
        uint(payload.rayMask),                                                            \
        currentRay                                                                        \
      );                                                                                  \
                                                                                          \
      while (rayQuery.Proceed())                                                          \
      {                                                                                   \
        if (softOmmTraversalMode != SOFT_OMM_TRAVERSAL_NONE)                              \
        {                                                                                 \
          if (rayQuery.CandidateType() == CANDIDATE_NON_OPAQUE_TRIANGLE)                  \
          {                                                                               \
            if (softOmmTraversalCommit(SOFT_OMM_TRAVERSAL_PASS_ID, softOmmTraversalMode,  \
                  rayQuery.CandidateInstanceID(), rayQuery.CandidateGeometryIndex(),      \
                  rayQuery.CandidatePrimitiveIndex(), rayQuery.CandidateTriangleBarycentrics())) \
            {                                                                             \
              rayQuery.CommitNonOpaqueTriangleHit();                                      \
            }                                                                             \
          }                                                                               \
        }                                                                                 \
      };                                                                                  \
                                                                                          \
      if (softOmmSkipMode != SOFT_OMM_SKIP_NONE)                                          \
      {                                                                                   \
        RayDesc softOmmRay = currentRay;                                                  \
        for (uint softOmmSkips = 0u; rayQuery.CommittedStatus() == COMMITTED_TRIANGLE_HIT; ++softOmmSkips) \
        {                                                                                 \
          const uint softOmmKind = softOmmResolveSkipKind(softOmmSkipMode,                \
            rayQuery.CommittedInstanceID(), rayQuery.CommittedGeometryIndex(),            \
            rayQuery.CommittedPrimitiveIndex(), rayQuery.CommittedTriangleBarycentrics()); \
          if (softOmmKind == 0u ||                                                        \
              (softOmmSkips >= SOFT_OMM_RESOLVE_MAX_SKIPS && softOmmSkipMode == SOFT_OMM_SKIP_TRANSPARENT)) \
          {                                                                               \
            if (softOmmKind != 0u)                                                        \
            {                                                                             \
              softOmmCountResolve(SOFT_OMM_RESOLVE_PASS_ID, SOFT_OMM_RESOLVE_COUNTER_CAP); \
            }                                                                             \
            break;                                                                        \
          }                                                                               \
          softOmmRay.TMin = softOmmNextRayT(rayQuery.CommittedRayT());                    \
          const bool softOmmAtCap = softOmmSkips >= SOFT_OMM_RESOLVE_MAX_SKIPS;           \
          softOmmCountResolve(SOFT_OMM_RESOLVE_PASS_ID, softOmmAtCap ? SOFT_OMM_RESOLVE_COUNTER_CAP : \
            (softOmmSkipMode == SOFT_OMM_SKIP_CULL_NON_OPAQUE ? SOFT_OMM_RESOLVE_COUNTER_NON_OPAQUE : SOFT_OMM_RESOLVE_COUNTER_TRANSPARENT)); \
          rayQuery.TraceRayInline(                                                        \
            topLevelAS,                                                                   \
            softOmmAtCap ? softOmmRequestedFlags : softOmmTraceFlags,                     \
            uint(payload.rayMask),                                                        \
            softOmmRay                                                                    \
          );                                                                              \
          while (rayQuery.Proceed())                                                      \
          {                                                                               \
          };                                                                              \
          if (softOmmAtCap)                                                               \
          {                                                                               \
            break;                                                                        \
          }                                                                               \
        }                                                                                 \
      }                                                                                   \
                                                                                          \
      /* Construct hit info from the hit */                                               \
      rayHitInfo.hasHit = rayQuery.CommittedStatus() == COMMITTED_TRIANGLE_HIT;           \
      rayHitInfo.hitDistance = rayQuery.CommittedRayT();                                  \
      rayHitInfo.barycentricCoordinates = barycentricsToUint(rayQuery.CommittedTriangleBarycentrics());\
      rayHitInfo.primitiveIndex = rayQuery.CommittedPrimitiveIndex();                     \
      rayHitInfo.customIndex = rayQuery.CommittedInstanceID();                            \
      rayHitInfo.geometryIndex = rayQuery.CommittedGeometryIndex();                       \
      rayHitInfo.frontHit = rayQuery.CommittedTriangleFrontFace();                        \
      }                                                                                   \
                                                                                          \
      /* Call the hit function */                                                         \
      hitFunction(extraArgs, rayHitInfo, payload);                                        \
    }                                                                                     \
                                                                                          \
    /* Check if the resolve loop should continue */                                       \
                                                                                          \
    if (!payload.continueResolving)                                                       \
    {                                                                                     \
      break;                                                                              \
    }                                                                                     \
                                                                                          \
    /* Update current ray for next iteration */                                           \
                                                                                          \
    currentRay.Origin = payload.origin;                                                   \
    currentRay.Direction = payload.direction;                                             \
    currentRay.TMax = max(currentRay.TMax - segmentHitDistance, 0.0f);                    \
  }                                                                                       \
                                                                                          \
  if ((cb.debugView == interactionsDebugView1 || cb.debugView == interactionsDebugView2)  \
    && allowWriteToInteractionsDebugViews)                                                \
  {                                                                                       \
    accumulateInDebugViewAdd(payload.pixelCoordinate, interactionIteration);              \
  }                                                                                       \
}

#ifdef RT_TRACE_RAY

#define RESOLVE_RAY_TRACE(                                                                \
  extraArgs, ray, flags, sbtRecordOffset,                                                 \
  hitFunction,                                                                            \
  maxInteractions, payload, segmentHitDistance,                                           \
  interactionsDebugView1, interactionsDebugView2, allowWriteToInteractionsDebugViews)     \
{                                                                                         \
  /* Initialize the payload with the current ray's state */                               \
                                                                                          \
  RayDesc currentRay;                                                                     \
  currentRay.Origin = ray.origin;                                                         \
  currentRay.TMin = 0.f;                                                                  \
  currentRay.TMax = ray.tMax;                                                             \
  currentRay.Direction = ray.direction;                                                   \
                                                                                          \
  payload.origin = ray.origin;                                                            \
  payload.coneRadius = ray.coneRadius;                                                    \
  payload.direction = ray.direction;                                                      \
                                                                                          \
  /* Loop until a surface is resolved, or the maximum interaction count is hit */         \
  uint8_t interactionIteration;                                                           \
  for (interactionIteration = uint8_t(1);; ++interactionIteration)                        \
  {                                                                                       \
    /* Reset the hit distance used for Resolve logic for this next iteration */           \
                                                                                          \
    payload.continueResolving = interactionIteration < maxInteractions;                   \
                                                                                          \
    /* Preform the ray trace with the desired information */                              \
                                                                                          \
    /* Note: Live state across this call (not put into payload as it is not */            \
    /* needed for anything on the hit function side of things):             */            \
    /* - interactionIteration                                               */            \
    /* - currentRay.tMax                                                    */            \
                                                                                          \
{                                                                                         \
  /* Invoke Trace Ray */                                                                  \
                                                                                          \
  /* Note: CHS responsible for decoding the payload, calling the proper hit function, */  \
  /* and then encoding the payload once again. This behavior must be done to match */     \
  /* the RayQuery path. */                                                                \
  /* For rtx.alphaBake.softwareOmmResolveSkip, see the */                                 \
  /* RayQuery path. The closest-hit shader skips (softOmmClosestHitSkip) and reports the */ \
  /* hit distance; the loop re-traces past it without counting an interaction. */          \
  const uint softOmmRequestedFlags =                                                      \
    resolveIterationRayFlags(flags, interactionIteration, !payload.continueResolving);    \
  uint softOmmSkipMode;                                                                   \
  const uint softOmmTraceFlags = softOmmResolveFlags(SOFT_OMM_RESOLVE_PASS_ID, softOmmRequestedFlags, softOmmSkipMode); \
  RayDesc softOmmRay = currentRay;                                                        \
  for (uint softOmmSkips = 0u;; ++softOmmSkips)                                           \
  {                                                                                       \
    const bool softOmmAllowSkip = softOmmSkipMode != SOFT_OMM_SKIP_NONE &&                \
                                  softOmmSkips < SOFT_OMM_RESOLVE_MAX_SKIPS;              \
    const bool softOmmCullFallback = softOmmSkipMode == SOFT_OMM_SKIP_CULL_NON_OPAQUE &&  \
                                     softOmmSkips >= SOFT_OMM_RESOLVE_MAX_SKIPS;          \
    if (softOmmSkipMode != SOFT_OMM_SKIP_NONE)                                            \
    {                                                                                     \
      payload.continueResolving = interactionIteration < maxInteractions;                 \
      softOmmPayloadSetSkipMode(payload, softOmmAllowSkip ? softOmmSkipMode : SOFT_OMM_SKIP_NONE); \
      if (!softOmmAllowSkip)                                                              \
      {                                                                                   \
        softOmmCountResolve(SOFT_OMM_RESOLVE_PASS_ID, SOFT_OMM_RESOLVE_COUNTER_CAP);      \
      }                                                                                   \
    }                                                                                     \
    TraceRayCustom(                                                                       \
      topLevelAS,                                                                         \
      softOmmCullFallback ? softOmmRequestedFlags : softOmmTraceFlags,                    \
      uint(payload.rayMask),                                                              \
      sbtRecordOffset, /* sbtRecordOffset */                                              \
      0u, /* sbtRecordStride */                                                           \
      0u, /* missIndex */                                                                 \
      softOmmRay,                                                                         \
      payload                                                                             \
    );                                                                                    \
    if (!softOmmAllowSkip || !softOmmPayloadSkipped(payload))                             \
    {                                                                                     \
      break;                                                                              \
    }                                                                                     \
    softOmmRay.TMin = softOmmNextRayT(softOmmPayloadSkippedT(payload));                   \
    softOmmCountResolve(SOFT_OMM_RESOLVE_PASS_ID, softOmmSkipMode == SOFT_OMM_SKIP_CULL_NON_OPAQUE \
      ? SOFT_OMM_RESOLVE_COUNTER_NON_OPAQUE : SOFT_OMM_RESOLVE_COUNTER_TRANSPARENT);      \
  }                                                                                       \
}                                                                                         \
                                                                                          \
    /* Check if the resolve loop should continue */                                       \
                                                                                          \
    if (!payload.continueResolving)                                                       \
    {                                                                                     \
      break;                                                                              \
    }                                                                                     \
                                                                                          \
    /* Update current ray for next iteration */                                           \
                                                                                          \
    currentRay.Origin = payload.origin;                                                   \
    currentRay.Direction = payload.direction;                                             \
    currentRay.TMax = max(currentRay.TMax - segmentHitDistance, 0.0f);                    \
  }                                                                                       \
                                                                                          \
  if ((cb.debugView == interactionsDebugView1 || cb.debugView == interactionsDebugView2)  \
    && allowWriteToInteractionsDebugViews)                                                \
  {                                                                                       \
    accumulateInDebugViewAdd(payload.pixelCoordinate, interactionIteration);            \
  }                                                                                       \
}
#else // !defined(RT_MIXED_TRACE_RAY), !defined(RT_TRACE_RAY)

#define RESOLVE_RAY_TRACE(                                                                \
  extraArgs, ray, flags, sbtRecordOffset,                                                 \
  hitFunction,                                                                            \
  maxInteractions, payload, segmentHitDistance,                                           \
  interactionsDebugView1, interactionsDebugView2, allowWriteToInteractionsDebugViews)     \
  RESOLVE_RAY_QUERY(extraArgs, ray, flags, hitFunction, maxInteractions, payload, segmentHitDistance, interactionsDebugView1, interactionsDebugView2, allowWriteToInteractionsDebugViews)

#endif
   